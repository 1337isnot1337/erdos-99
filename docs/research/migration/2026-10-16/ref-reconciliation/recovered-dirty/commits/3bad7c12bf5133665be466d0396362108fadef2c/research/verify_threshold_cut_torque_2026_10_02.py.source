#!/usr/bin/env python3
"""Exact embedded-source cut torque and moment-Gram regressions.

Encoded: all pair distances of the unit square/hexagon, actual full active sets,
positive normalized vertex equilibrium, PSD and affine scalar kernel, uniform
opposite-side cuts, torque centroids and cut moment forms. Arithmetic: Q and
Q(sqrt(3)), using SymPy. Omitted: global optimality, a linear complete O--O
rectangle, canonical mixed rigidity, and finite train-move feasibility. PASS
certifies these two exact regressions, not a closing theorem or all-q census.
"""
from itertools import combinations
import sympy as sp


def zero(x):
    assert sp.simplify(x) == 0, x


def matrix_equal(x, y):
    for v in x - y:
        zero(v)


def cross(a, b):
    return a[0] * b[1] - a[1] * b[0]


def squared(v):
    return sp.expand(v.dot(v))


def check_source(points, d2):
    n = len(points)
    contacts, diameters = [], []
    for i, j in combinations(range(n), 2):
        ds = sp.simplify(squared(points[j] - points[i]))
        assert ds >= 1 and ds <= d2
        if ds == 1:
            contacts.append((i, j))
        if ds == d2:
            diameters.append((i, j))
    assert len(contacts) == n and len(diameters) == n // 2
    assert not any(all(tuple(sorted(e)) in contacts for e in combinations(t, 2))
                   for t in combinations(range(n), 3))
    alpha = sp.Rational(d2, n)
    beta = sp.Rational(2, n)
    zero(beta * len(diameters) - 1)
    zero(alpha * len(contacts) - d2)
    omega = sp.zeros(n)
    for edges, weight in ((contacts, alpha), (diameters, -beta)):
        for i, j in edges:
            omega[i, i] += weight
            omega[j, j] += weight
            omega[i, j] -= weight
            omega[j, i] -= weight
    p = sp.Matrix.hstack(*points).T
    matrix_equal(omega * p, sp.zeros(n, 2))
    matrix_equal(omega * sp.ones(n, 1), sp.zeros(n, 1))
    matrix_equal(omega * omega, 2 * omega)  # symmetric: eigenvalues 0 or 2
    assert omega.rank() == n - 3
    assert sp.Matrix.hstack(sp.ones(n, 1), p).rank() == 3
    for i, j in diameters:
        matrix_equal(points[i] + points[j], sp.zeros(2, 1))

    cuts = 0
    for start in range(n // 2):
        inside = {(start + k) % n for k in range(n // 2)}
        ce = [(i, j) if j in inside else (j, i) for i, j in contacts
              if (i in inside) != (j in inside)]
        he = [(i, j) if j in inside else (j, i) for i, j in diameters
              if (i in inside) != (j in inside)]
        assert len(ce) == 2 and len(he) == n // 2
        u = points[ce[0][1]] - points[ce[0][0]]
        for i, j in ce:
            matrix_equal(points[j] - points[i], u)
        ju = sp.Matrix([-u[1], u[0]])
        a = alpha * len(ce)
        w = beta * len(he)
        force = sum((beta * (points[j] - points[i]) for i, j in he),
                    sp.zeros(2, 1))
        matrix_equal(force, a * u)
        for origin in (sp.zeros(2, 1), sp.Matrix([sp.Rational(2, 7),
                                                sp.Rational(-3, 11)])):
            q = sp.Matrix([ju.dot(v - origin) for v in points])
            centroid = sum(alpha * (q[i] + q[j]) / 2 for i, j in ce) / a
            torque = sum(beta * cross((points[i] + points[j]) / 2 - origin,
                                     points[j] - points[i]) for i, j in he)
            zero(a * centroid + torque)
            chi = sp.Matrix([int(i in inside) for i in range(n)])
            qchi = sp.matrix_multiply_elementwise(q, chi)
            basis = sp.Matrix.hstack(chi, qchi)
            gram = basis.T * omega * basis
            off = a * centroid - sum(beta * (q[i] + q[j]) / 2 for i, j in he)
            lower = sum(alpha * ((q[i] + q[j]) / 2)**2 for i, j in ce)
            lower -= sum(beta * q[i] * q[j] for i, j in he)
            expected = sp.Matrix([[a - w, off], [off, lower]])
            matrix_equal(gram, expected)
            assert sp.simplify(gram[0, 0]) >= 0
            assert sp.simplify(gram[1, 1]) >= 0
            assert sp.simplify(gram.det()) >= 0
            if origin == sp.zeros(2, 1):
                zero(centroid)
                variance = sp.simplify(sum(alpha * ((q[i]+q[j])/2)**2
                                          for i, j in ce) / a)
                assert variance > sp.Rational(d2, 16)
                for i, j in ce:
                    assert sp.simplify(((q[i]+q[j])/2)**2) == variance
                identity = a * variance + sum(beta * (q[j] - q[i])**2 / 4
                                              for i, j in he)
                zero(gram[1, 1] - identity)
        cuts += 1
    return len(list(combinations(points, 2))), cuts


def main():
    half = sp.Rational(1, 2)
    square = [sp.Matrix(v) for v in ((half, half), (-half, half),
                                    (-half, -half), (half, -half))]
    root = sp.sqrt(3) / 2
    hexagon = [sp.Matrix(v) for v in ((1, 0), (half, root), (-half, root),
                                     (-1, 0), (-half, -root), (half, -root))]
    pair_count, cut_count = 0, 0
    for points, d2 in ((square, 2), (hexagon, 4)):
        pairs, cuts = check_source(points, d2)
        pair_count += pairs
        cut_count += cuts
    print(f"PASS: {pair_count} exact pair distances; {cut_count} uniform cuts; "
          "full positive equilibrium, PSD/affine scalar kernel, torque transport, "
          "moment Grams and peripheral-port variance; two origins per cut")


if __name__ == "__main__":
    main()
