        report: "docs/reports/target_c_cyclic_d1_s1_q13_kkt_psd_regression_2026-09-10.md"
        audit: "docs/reports/target_c_cyclic_shell_d1_p1_s1_dependency_audit_2026-09-11.md"
        status: regression
        scope: "finite q=13 primitive S1 shell"
        conclusion: "the displayed shell, active sets, positive KKT stress, maximal-rank PSD interior stress, and PSD KKT endpoints are independently numerically reproduced; no interval-certified global-minimizer claim is made"
        certificates:
          - "research/target_c_s1_q13_shell_regression.py"
          - "research/verify_s1_q13_kkt_endpoints.py"
        depends_on:
          - "C-S1-RSQ"
      - id: "C-CROSSING-MULTISHEAR-INDEPENDENT-OWNER-REGRESSION"
        report: "docs/audits/target_c_owner_order_and_terminal_capacity_promotion_audit_2026-10-06.md"
        audit: "docs/audits/target_c_owner_order_and_terminal_capacity_promotion_audit_2026-10-06.md"
        status: regression
        scope: "finite rational strict unit rhombus; crossing train variables preserve all four unit contacts in their coupled states, but the corresponding region translations are not valid independent binary owner variables"
        conclusion: "the exact rhombus has contact-preserving train states 00, 10, 01, 11, while the independent-owner singleton state changes a contact squared length by -47928/13000013; arbitrary crossing multishears cannot be compiled as independent binary owners"
        certificates:
          - "research/verify_target_c_binary_crossing_scope_2026_10_06.py"
        depends_on: []
      - id: "C-TWO-WALL-DELETION-EXTERIOR-SHIELD-REGRESSION"
        report: "docs/audits/target_c_owner_order_and_terminal_capacity_promotion_audit_2026-10-06.md"
        audit: "docs/audits/target_c_owner_order_and_terminal_capacity_promotion_audit_2026-10-06.md"
        status: regression
        scope: "finite unit square wall with an outside contact isolate; two wall vertices are deleted and the proposed interior replacement is tested against the full retained source"
        conclusion: "the point (1/2,1/20) is clear of the two retained top wall vertices but has squared distance 361/400<1 from the retained isolate (1/2,-9/10); the one-vertex shield cannot be iterated across two deletions without additional guards"
        certificates:
          - "research/verify_target_c_one_vertex_wall_shield_2026_10_06.py"
        depends_on: []
      - id: "C-ABSTRACT-OWNER-HORN-PACKET"
        report: "docs/audits/target_c_owner_order_and_terminal_capacity_promotion_audit_2026-10-06.md"
        audit: "docs/audits/target_c_owner_order_and_terminal_capacity_promotion_audit_2026-10-06.md"
        status: regression
        scope: "abstract four-crosscut star, repeated owner labels, loaded cyclic witness roles, Horn clauses, and bad-terminal budget only; no source coordinates, KKT equilibrium, actual motion, or global optimality"
        conclusion: "the encoded hub/tree/terminal constraints permit a two-owner zero-only Horn system and therefore do not alone imply a useful pinned assignment; the u_B=0 narrow-window packet is separately excluded at source level by C-BINARY-LOADED-WITNESS-POCKET-BUDGET"
        certificates:
          - "research/verify_target_c_hub_owner_systems_2026_10_06.py"
        depends_on:
          - "C-BINARY-LOADED-WITNESS-POCKET-BUDGET"
      - id: "C-REGULAR-SHELL-BARRIER-NONGLOBAL-FAMILY"
        report: "docs/audits/target_c_odd_shell_barrier_payment_independent_audit_2026-10-06.md"
        audit: "docs/audits/target_c_odd_shell_barrier_payment_independent_audit_2026-10-06.md"
        status: regression
        scope: "explicit odd-q>=65 regular-shell source with a fully blocked one-vertex wall proposal set and quadratic deep fill; not a global minimizer"
        conclusion: "positive shell multipliers, PSD shell stress, mixed core rigidity, a physical blocker cover, and quadratic interior population do not imply global optimality: a same-cardinality whole-source packet has strictly smaller diameter"
        certificates:
          - "research/verify_target_c_odd_shell_single_vertex_barriers_2026_10_06.py"
        depends_on: []
      - id: "C-HEPTAGON-WALL-CAPACITY-REGRESSION"
        report: "docs/audits/target_c_collective_wall_capacity_independent_audit_2026-10-06.md"
        audit: "docs/audits/target_c_collective_wall_capacity_independent_audit_2026-10-06.md"
        status: regression
        scope: "globally optimal n=8 source consisting of a regular unit heptagon and its center; any nonempty eligible wall deletion set B with pairwise distance at least two"
        conclusion: "the strict wall-safe region has diameter below one and unit-separated capacity exactly one, while the retained interior population is one; hence no packet of size |S|+|B| exists, despite global optimality, positive shell multipliers, PSD core stress, and mixed core rank 2v-3; no sufficiently-large or Level I claim is refuted"
        certificates:
          - "research/verify_target_c_collective_wall_capacity_audit_2026_10_06.py"
        depends_on: []
    rejected_or_overridden:
      - id: "C-PATH-EULER"
        status: rejected
        claim: "consecutive incident diameter states imply an Euler trail/path"
        reason: "three-edge star counterexample"
        depends_on: []
      - id: "C-FB4"
        status: rejected
        claim: "force-bulk localization/FB4"
        reason: "exact heptagon-plus-center audit"
        depends_on: []
      - id: "C53-BAD-PENTAGON"
        status: rejected
        claim: "incorrectly normalized pentagon regression refutes C53"
        reason: "incompatible projective cut/orientation"
        depends_on: []
      - id: "RSR-EQUALITY-UNIQUE"
        status: rejected
        claim: "Rogalski-Saint Raymond 1985 proves disk is the unique equality case"
        reason: "source leaves uniqueness as an open problem"
        depends_on: []
      - id: "C-FIVE-ARC-NEAR-QUAD"
        status: rejected
        claim: "the five-arc endpoint forces near-quadrangulation by Eppstein equality"
        reason: "Eppstein's bound is inductive and supplies no such equality classification; the PR #188 numerical theorem survives independently"
        depends_on: []
      - id: "C-FIVE-HOST-OCCUPANCY"
        status: rejected
        claim: "five-component endpoint packing saturation by itself proves that all five host components contain actual attachment pins"
        reason: "total angular measure saturation is not an occupancy theorem; the repaired endpoint proof needs only three occupied hosts"
        depends_on: []
      - id: "C-CYCLIC-CAP-DETOUR"
        status: rejected
        claim: "an inward OP outer pocket is contained in the exterior Reuleaux minor cap, hence ell<=D phi and b-P_F=O(sqrt D) in every Woodall-cyclic survivor"
        reason: "pocket and minor cap lie on opposite sides of the force-hull chord; exact pentagon-center regression violates ell<=D phi"
        depends_on:
          - "C-WOODALL"
      - id: "C-CYCLIC-099554"
        status: rejected
        claim: "PR #191 proves liminf (e_BB+2s_C)/D >= 0.99554058458... with a qualitative endpoint gap"
        reason: "the cavity/train proof depends on the rejected cyclic inward-cap detour; the later scalar audit does not repair this missing premise"
        depends_on:
          - "C-CYCLIC-CAP-DETOUR"
      - id: "C-ZRF-FULL-SOURCE"
        status: rejected
        claim: "ZR/ZF gives ker Omega=span{1,Px,Py} and mixed rigidity rank 2v-3 on the full source including contact-isolated points"
        reason: "contact-isolated source points contribute zero stress rows/columns and independent kernel coordinates; the audited ZR/ZF theorem is only on the nonisolated positive-contact core V"
        depends_on:
          - "C-ZRF"

