state_version: "2026-10-06.audit.66"
state_date: "2026-10-06"
cleanup_baseline: "34085ac264eb5241985de7b453bf7d612a25fa4d"
level_i_status: open

status_vocabulary:
  canonical: "proved/audited and part of the active theorem stack"
  unreviewed: "research artifact not independently audited or promoted; never an unqualified premise"
  audited-working: "proof plus audit/correction history, not promoted as a canonical dependency"
  conditional: "depends on an unproved or unresolved hypothesis"
  regression: "exact or certified obstruction to an overstrong claim"
  superseded: "historically valid/formerly current but not the live frontier"
  rejected: "proof or claimed implication is invalid"
  provenance: "history only; not a theorem source"

authority_order:
  - "docs/STATE.md and this manifest for lifecycle/status"
  - "active target route map and explicitly named canonical modules"
  - "reports explicitly promoted by the state lock or route map"
  - "audited-working reports"
  - "conditional reports and regressions"
  - "unreviewed research artifacts"
  - "superseded, rejected, and provenance material"

defaults:
  report_not_explicitly_promoted: unreviewed
  archived_document: provenance
  historical_prompt: provenance
  merged_pull_request_without_promotion: unreviewed
  file_on_main_without_promotion: unreviewed
  target_c_colocated_module_not_named_by_route_map: provenance
  module_local_handoff_prose: "historical at that module's section unless repeated by the current route map"

terminology:
  woodall_cyclic_branch: "full loaded diameter graph H has d_H=0 and is connected odd-unicyclic"
  cyclic_shell: "historical shell/projective-direction wording; may occur in old d_H=1 P1/S1 report titles and does not mean Woodall cyclic"

artifact_policy:
  index: "docs/state/artifact-index.jsonl"
  roots:
    - "docs/reports"
    - "docs/audits"
    - "docs/archive"
  exclude:
    - "docs/reports/README.md"
    - "docs/reports/REPORT_TEMPLATE.md"
    - "docs/archive/README.md"
  metadata_header: "theorem-state"
  default_status: unreviewed
  archive_status: provenance

graph_policy:
  canonical_dependency_statuses:
    - canonical
  require_resolved_edges: true
  require_acyclic_depends_on: true

generated_views:
  status_summary: "docs/state/STATUS.generated.md"
  theorem_graph: "docs/state/THEOREM_GRAPH.generated.md"

certificate_policy:
  run_in_ci: true
  require_paths_exist: true

