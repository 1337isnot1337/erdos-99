\text{near-constant-width diametral hull}\\
+\text{ }n-O(\sqrt n)\text{ strict near-}60^\circ\text{ rhombi}\\
+\text{ finitely many near-triangular orientation grains}\\
+\text{ }O(\sqrt n)\text{-scale nonlattice shell}\\
+\text{ exact support-turning cancellation}\\
+\text{ }\Theta(\sqrt n)\text{ train/shear modes to lock}.
\end{array}
