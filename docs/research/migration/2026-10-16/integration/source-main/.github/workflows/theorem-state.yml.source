name: theorem-state

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]

permissions:
  contents: read

concurrency:
  group: localized-ci-${{ github.event.pull_request.number }}
  cancel-in-progress: true

# Both variables default to unset. Owner authorization is a separate rollout step.
# No push, schedule, dispatch, historical matrix, or full-certificate execution.
jobs:
  plan:
    if: vars.E99_LOCALIZED_CI == 'true' && github.event.pull_request.draft == false
    runs-on: ubuntu-latest
    timeout-minutes: 3
    outputs:
      replay: ${{ steps.plan.outputs.replay }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: ${{ github.event.pull_request.base.sha }}
          path: control
          persist-credentials: false
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          path: candidate
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: '3.14.7'
      - name: Install trusted integrity dependencies
        run: >-
          python3 -m pip install --disable-pip-version-check --require-hashes
          --only-binary=:all: -r control/tools/requirements-integrity-linux-x86_64.lock
      - name: Essential trusted tooling regressions
        working-directory: control
        run: python3 -B -m unittest tools.test_local_ci tools.test_check_theorem_state_pr tools.test_check_active_route_summaries
      - name: Plan and check metadata using trusted base tools
        id: plan
        run: >-
          python3 -B control/tools/local_ci.py --root candidate
          --event-file "$GITHUB_EVENT_PATH" --integrity --require-localized
          --output "$RUNNER_TEMP/e99-plan" --github-output "$GITHUB_OUTPUT"
      - name: Explain bounded verification result
        if: always()
        run: |
          if test -f "$RUNNER_TEMP/e99-plan/plan.json"; then
            cat "$RUNNER_TEMP/e99-plan/plan.json"
            cat "$RUNNER_TEMP/e99-plan/plan.json" >> "$GITHUB_STEP_SUMMARY"
          fi
          if test -f "$RUNNER_TEMP/e99-plan/integrity.log"; then
            cat "$RUNNER_TEMP/e99-plan/integrity.log"
          fi
      - name: Require replay availability for affected packages
        if: steps.plan.outputs.replay == 'true' && vars.E99_PACKAGE_REPLAY != 'true'
        run: |
          echo 'Targeted replay is required and remains gated pending owner authorization.'
          exit 3

  replay:
    needs: plan
    if: needs.plan.outputs.replay == 'true' && vars.E99_PACKAGE_REPLAY == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 6
    # One serial batch, capped at two packages / 240 declared seconds. No matrix.
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: ${{ github.event.pull_request.base.sha }}
          path: control
          persist-credentials: false
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          path: candidate
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: '3.14.7'
      - name: Install trusted planner dependencies
        run: >-
          python3 -m pip install --disable-pip-version-check --require-hashes
          --only-binary=:all: -r control/tools/requirements-integrity-linux-x86_64.lock
      - name: Recompute pinned impact and replay serially without credentials or network
        run: >-
          python3 -B control/tools/local_ci.py --root candidate
          --event-file "$GITHUB_EVENT_PATH" --replay --require-localized
          --output "$RUNNER_TEMP/e99-replay"
      - name: Explain targeted replay result
        if: always()
        run: |
          if test -f "$RUNNER_TEMP/e99-replay/replay.json"; then
            cat "$RUNNER_TEMP/e99-replay/replay.json"
            cat "$RUNNER_TEMP/e99-replay/replay.json" >> "$GITHUB_STEP_SUMMARY"
          fi
