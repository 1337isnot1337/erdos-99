name: Target C k6 Dminus1 Profile A rank-two audit

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  verify:
    if: github.actor == github.repository_owner && vars.E99_HISTORICAL_CI == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 180
    strategy:
      fail-fast: false
      matrix:
        include:
          - {start: 0, end: 1280}
          - {start: 1280, end: 2560}
          - {start: 2560, end: 3840}
          - {start: 3840, end: 5120}
          - {start: 5120, end: 6400}
          - {start: 6400, end: 7680}
          - {start: 7680, end: 8960}
          - {start: 8960, end: 10240}
          - {start: 10240, end: 11520}
          - {start: 11520, end: 12800}
          - {start: 12800, end: 14080}
          - {start: 14080, end: 15360}
          - {start: 15360, end: 16640}
          - {start: 16640, end: 17920}
          - {start: 17920, end: 19200}
          - {start: 19200, end: 20451}
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Run actual-state Profile A audit shard
        run: >-
          python research/verify_target_c_support7_global_segment_relative_eight_noroot_k6_dminus1_profile_a_actual_state_realization_2026_09_22.py
          --orbit-start ${{ matrix.start }}
          --orbit-end ${{ matrix.end }}
          --stop-on-survivor
          --require-no-survivors
