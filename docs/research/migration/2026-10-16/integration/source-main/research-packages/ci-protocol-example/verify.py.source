"""Finite protocol regression only; no E99 theorem claim."""
for x in range(-8, 9):
    for y in range(-8, 9):
        assert (x + y) ** 2 == x * x + 2 * x * y + y * y
# A negative control makes a known false variant fail somewhere in the full domain.
assert any((x + y) ** 2 != x * x + y * y
           for x in range(-8, 9) for y in range(-8, 9))
print('289 exact cases and negative control passed; finite regression only')
