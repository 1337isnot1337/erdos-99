#!/usr/bin/env python3
"""Exact generalized-weight closure of the e=3,m=3 and e=3,m=5 slices
of the final eight-no-root k=5,D=-1,d_root=0,p=6 branch.

Inputs already proved in the repository:
  * rank(P)=3 and generalized weights (d1,d2,d3)>=(2,4,5);
  * every survivor is generated by actual empty-block constraints plus at
    most two singleton constraints;
  * in the e=3 slice, tetrahedron-boundary rank is at most four;
  * m=3 has support multiplicity (3,3,2), while m=5 is the five tetrahedra
    on one five-vertex set.

For each cycle-set orbit and each triple of touched actual-empty blocks, this
verifier forms U=sum E_b exactly over Q. If rank(U)>3 the state is impossible.
If rank(U)=3 then P=U. If rank(U)=2 or 1, every possible rank-three P obtainable
from U with at most two singleton lines is enumerated. This is a superset of
actual root-state assignments, so failure of the generalized-weight floor
closes the slice without a root-state or relation-rank census.
"""
from collections import Counter
from fractions import Fraction
from itertools import combinations
from pathlib import Path
import contextlib
import importlib.util
import io

HERE = Path(__file__).resolve().parent

P3 = HERE / "verify_target_c_support7_global_segment_relative_eight_noroot_k5_dminus1_d1p3_three_support_closure_2026_09_23.py"
spec = importlib.util.spec_from_file_location("e99_p6_e3_m3_base", P3)
T = importlib.util.module_from_spec(spec)
with contextlib.redirect_stdout(io.StringIO()):
    spec.loader.exec_module(T)

P5 = HERE / "verify_target_c_support7_global_segment_relative_eight_noroot_k5_dminus1_d1p3_five_support_closure_2026_09_23.py"
spec = importlib.util.spec_from_file_location("e99_p6_e3_m5_base", P5)
F = importlib.util.module_from_spec(spec)
with contextlib.redirect_stdout(io.StringIO()):
    spec.loader.exec_module(F)

LOCAL = ((1, 0), (0, 1), (1, -1))


def touched_blocks(ext):
    return tuple(
        b for b in range(35)
        if any(T.R.QCOMP[e][b] != (0, 0) for e in ext)
    )


def empty_key(ext, block):
    x = tuple(T.R.QCOMP[e][block][0] for e in ext)
    y = tuple(T.R.QCOMP[e][block][1] for e in ext)
    return T.R.rowspace_key((x, y))


def singleton_key(ext, block, direction):
    lx, ly = direction
    row = tuple(
        lx * T.R.QCOMP[e][block][1] - ly * T.R.QCOMP[e][block][0]
        for e in ext
    )
    return T.R.rowspace_key((row,))


def generalized_weights(key):
    assert len(key) == 3
    cols = [tuple(row[j] for row in key) for j in range(8)]
    zero = (Fraction(0),) * 3
    z = cols.count(zero)
    d3 = 8 - z

    directions = Counter(T.R.rowspace_key((c,)) for c in cols if c != zero)
    d2 = 8 - (z + max(directions.values()))

    nonzero = [c for c in cols if c != zero]
    normals = set()
    for a, b in combinations(nonzero, 2):
        n = (
            a[1] * b[2] - a[2] * b[1],
            a[2] * b[0] - a[0] * b[2],
            a[0] * b[1] - a[1] * b[0],
        )
        if any(n):
            normals.add(T.R.rowspace_key((n,))[0])
    assert normals
    max_plane = max(
        sum(sum(n[i] * c[i] for i in range(3)) == 0 for c in cols)
        for n in normals
    )
    return 8 - max_plane, d2, d3


def candidate_spaces(ext, empties):
    U = ()
    for b in empties:
        U = T.R.rowspace_key(U + empty_key(ext, b))
    r = len(U)
    if r > 3:
        return (), r
    if r == 3:
        return (U,), r

    touched = touched_blocks(ext)
    lines = []
    seen = set()
    for b in touched:
        if b in empties:
            continue
        for direction in LOCAL:
            line = singleton_key(ext, b, direction)
            if len(line) == 1 and line not in seen:
                seen.add(line)
                lines.append(line[0])

    out = set()
    if r == 2:
        for line in lines:
            P = T.R.rowspace_key(U + (line,))
            if len(P) == 3:
                out.add(P)
    elif r == 1:
        for a, b in combinations(lines, 2):
            P = T.R.rowspace_key(U + (a, b))
            if len(P) == 3:
                out.add(P)
    return tuple(out), r


def scan(exts):
    counts = Counter()
    weights = Counter()
    for ext in exts:
        touched = touched_blocks(ext)
        for empties in combinations(touched, 3):
            counts["empty_triples"] += 1
            spaces, r = candidate_spaces(ext, empties)
            counts[f"Urank{r}"] += 1
            counts["rank3_candidate_spaces"] += len(spaces)
            for P in spaces:
                w = generalized_weights(P)
                weights[w] += 1
                if w[0] >= 2 and w[1] >= 4 and w[2] >= 5:
                    counts["generalized_weight_survivors"] += 1
    return counts, weights


def main():
    m3 = T.three_support_cycle_orbits()
    assert len(m3) == 32
    c3, w3 = scan(m3)
    assert dict(c3) == {
        "empty_triples": 5333,
        "Urank6": 1970,
        "Urank5": 2125,
        "Urank4": 1029,
        "Urank3": 133,
        "rank3_candidate_spaces": 1150,
        "Urank2": 76,
    }
    assert dict(w3) == {
        (1, 2, 3): 133,
        (1, 2, 4): 912,
        (1, 2, 6): 105,
    }

    m5 = F.five_support_cycle_orbits()
    assert len(m5) == 43
    c5, w5 = scan(m5)
    assert dict(c5) == {
        "empty_triples": 5160,
        "Urank5": 1496,
        "Urank6": 3420,
        "Urank4": 220,
        "Urank3": 23,
        "rank3_candidate_spaces": 38,
        "Urank2": 1,
    }
    assert dict(w5) == {
        (1, 2, 3): 14,
        (1, 3, 4): 11,
        (2, 3, 4): 2,
        (2, 3, 5): 8,
        (2, 3, 6): 2,
        (2, 3, 7): 1,
    }

    assert c3["generalized_weight_survivors"] == 0
    assert c5["generalized_weight_survivors"] == 0

    print("PASS: p=6 e=3 m=3 and m=5 generalized-weight closure")
    print("m3_cycle_set_orbits", len(m3))
    print("m3_counts", dict(c3))
    print("m3_generalized_weights", dict(sorted(w3.items())))
    print("m5_cycle_set_orbits", len(m5))
    print("m5_counts", dict(c5))
    print("m5_generalized_weights", dict(sorted(w5.items())))


if __name__ == "__main__":
    main()
