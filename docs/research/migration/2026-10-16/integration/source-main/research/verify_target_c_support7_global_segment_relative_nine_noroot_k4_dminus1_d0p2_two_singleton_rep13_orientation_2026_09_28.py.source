#!/usr/bin/env python3
from collections import Counter

import verify_target_c_support7_global_segment_relative_nine_noroot_k4_dminus1_d0p2_selected_pair_orientation_2026_09_28 as B

# Exact two-singleton orientation certificate for the explicit support
# [0123]^3 [0124]^3 [0134] [0234] [1234].
# The imported verifier supplies the exact K8 quotient coordinates, rational
# rowspace operations, triangle-row ranks, parity-profile test, and orientation
# enumeration already audited on main.

REP = [
    ((0, 1, 2, 3), 3),
    ((0, 1, 2, 4), 3),
    ((0, 1, 3, 4), 1),
    ((0, 2, 3, 4), 1),
    ((1, 2, 3, 4), 1),
]


def local_rows(ext, block):
    vals = [B.QCOMP[e][block] for e in ext]
    return tuple(v[0] for v in vals), tuple(v[1] for v in vals)


def singleton_keys(ext, block):
    xrow, yrow = local_rows(ext, block)
    out = []
    for lx, ly in B.LOCAL:
        normal = tuple(lx * y - ly * x for x, y in zip(xrow, yrow))
        out.append(B.rowspace_key((normal,)))
    return tuple(out)


def candidate_rank4_spaces(ext, touched):
    # Superset: arbitrary actual-empty sources plus at most two nonzero
    # singleton-line sources, without enforcing a legal root-state assignment.
    empty_sources = []
    singleton_sources = []
    for block in touched:
        E = B.empty_key(ext, block)
        if E:
            empty_sources.append(E)
        singleton_sources.extend(L for L in singleton_keys(ext, block) if L)
    empty_sources = list(dict.fromkeys(empty_sources))
    singleton_sources = list(dict.fromkeys(singleton_sources))

    states = {((), 0)}
    for E in empty_sources:
        nxt = set(states)
        for W, q in states:
            J = B.union_key(W, E)
            if len(J) <= 4:
                nxt.add((J, q))
        states = nxt
    for L in singleton_sources:
        nxt = set(states)
        for W, q in states:
            if q >= 2:
                continue
            J = B.union_key(W, L)
            if len(J) <= 4:
                nxt.add((J, q + 1))
        states = nxt
    return {W for W, _ in states if len(W) == 4}


def structural_reason(ext, W, touched):
    # V(W) contains every actual touched incomplete block: actual-empty blocks
    # have E_b <= W; a selected singleton has a zero or contained singleton line.
    virtual_incomplete = set()
    for block in touched:
        if B.is_subspace(B.empty_key(ext, block), W):
            virtual_incomplete.add(block)
            continue
        if any((not L) or B.is_subspace(L, W) for L in singleton_keys(ext, block)):
            virtual_incomplete.add(block)

    touched_mask = sum(1 << b for b in touched)
    incomplete_mask = sum(1 << b for b in virtual_incomplete)
    complete_mask = touched_mask & ~incomplete_mask
    rc = B.h_rank(complete_mask)
    if rc != complete_mask.bit_count():
        return "dependent"
    if B.h_rank(touched_mask) - rc < 4:
        return "capacity"
    return "pass"


def main():
    assert REP == B.REP13
    census = Counter()
    for ext in B.oriented_exts(REP):
        census["orientations"] += 1
        touched = tuple(sorted({b for e in ext for b, v in enumerate(B.QCOMP[e]) if v != (0, 0)}))
        spaces = candidate_rank4_spaces(ext, touched)
        census["rank4_spaces"] += len(spaces)
        for W in spaces:
            if not B.parity_profile_ok(W):
                continue
            census["weight_pass"] += 1
            census[structural_reason(ext, W, touched)] += 1

    expected = Counter({
        "orientations": 27,
        "rank4_spaces": 36516,
        "weight_pass": 702,
        "dependent": 318,
        "capacity": 384,
    })
    print(dict(census))
    assert census == expected, (census, expected)
    assert census["pass"] == 0
    print("PASS: explicit rep13 two-singleton profile has zero structural survivors")


if __name__ == "__main__":
    main()
