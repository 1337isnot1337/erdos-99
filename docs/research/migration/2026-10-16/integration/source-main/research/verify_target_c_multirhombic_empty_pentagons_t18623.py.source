#!/usr/bin/env python3
"""Exact outward certificate for multi-rhombic pentagon populations in Branch R."""
from fractions import Fraction as Q
from math import isqrt


def atan_inv_bounds(q,n):
    s=Q(0)
    for k in range(n):
        term=Q(1,(2*k+1)*q**(2*k+1))
        s += term if k%2==0 else -term
    nxt=Q(1,(2*n+1)*q**(2*n+1))
    return (s,s+nxt) if n%2==0 else (s-nxt,s)


def sqrt_bounds(lo,hi,scale):
    a=isqrt((lo.numerator*scale*scale)//lo.denominator)
    b=isqrt((hi.numerator*scale*scale)//hi.denominator)
    return Q(a,scale),Q(b+1,scale)


a5l,a5h=atan_inv_bounds(5,90)
a239l,a239h=atan_inv_bounds(239,25)
pil,pih=16*a5l-4*a239h,16*a5h-4*a239l
S=10**90
n3=isqrt(3*S*S)
s3l,s3h=Q(n3,S),Q(n3+1,S)
Dl,Dh=pil/(2*s3h),pih/(2*s3l)
sDl,sDh=sqrt_bounds(Dl,Dh,S)
C707=2*sDl+Q(7707,1000000)
tau0=Q(7467921,10000000)


def cert(T, x2_claim, x3_claim):
    f0=C707/2-T/4
    Q0=2*T-pil
    p50=2*f0-Q0
    I0=5*p50-tau0
    # If X2 pentagons have >=2 rhombus sides, then I5 <= P5+4X2.
    # Use P5<=Q<=Q0.
    x2=(I0-Q0)/4
    # If X3 pentagons have >=3 rhombus sides, then I5 <= 2P5+3X3.
    x3=(I0-2*Q0)/3
    assert x2>x2_claim
    assert x3>x3_claim
    print('T=',float(T))
    print('  Q/D upper =',float(Q0))
    print('  P5/D lower =',float(p50))
    print('  I5/D lower =',float(I0))
    print('  P5(>=2R)/D lower =',float(x2),'margin',float(x2-x2_claim))
    print('  P5(>=3R)/D lower =',float(x3),'margin',float(x3-x3_claim))


cert(Q(37,20),       Q(2098,10000), Q(936,10000))
cert(Q(371,200),     Q(1917,10000), Q(661,10000))
cert(Q(93,50),       Q(1736,10000), Q(386,10000))
cert(Q(18623,10000), Q(1652,10000), Q(260,10000))
print('PASS: Branch R forces linear multi-rhombic pentagon populations')
