#!/usr/bin/env python3
"""Regression checks for the nested-rail host/death-plateau dichotomy."""

from fractions import Fraction
from math import pow


def nondec(xs):
    return all(a <= b for a, b in zip(xs, xs[1:]))


def noninc(xs):
    return all(a >= b for a, b in zip(xs, xs[1:]))


# Build exact one-turn hubward words with tagged physical pieces:
# U = first host side, T = terminal piece, D = second host side.
for m in range(2, 9):
    k = 1
    master = []
    for r in range(k, m + 1):
        master.append((r, "U"))
    master.extend([(m, "T"), (m, "T")])
    for r in range(m, k - 1, -1):
        master.append((r, "D"))

    n = len(master)
    # Exhaust all nonempty selected subsequences.
    for mask in range(1, 1 << n):
        sub = [master[j] for j in range(n) if mask & (1 << j)]
        labels = [r for r, _ in sub]

        # Plus/nested orientation: selected labels nondecreasing.
        if nondec(labels):
            wrong = [r for r, tag in sub if tag != "U"]
            assert len(set(wrong)) <= 1, (m, sub, "plus")

        # Minus/nested orientation: selected labels nonincreasing.
        if noninc(labels):
            wrong = [r for r, tag in sub if tag != "D"]
            assert len(set(wrong)) <= 1, (m, sub, "minus")


# Exact nested support implication and common-death endpoint tag.
births = [2, 5, 9, 12, 16]
k = 20
deaths = [37, 34, 34, 29, 23]
assert noninc(deaths)
intervals = [set(range(i + 1, b + 1)) for i, b in zip(births, deaths)]
assert all(k in I for I in intervals)
assert all(intervals[s + 1] < intervals[s] for s in range(len(intervals) - 1))
# Equal death tags really are one common support-end interface.
plateau = [s for s, b in enumerate(deaths) if b == 34]
assert plateau == [1, 2]


# Quantitative constants inherited from the parameterized braid.
c0 = Fraction(113, 20_000_000)
lambda90 = Fraction(9, 10) * c0
parent90 = float(lambda90) / (16.0 * pow(3.0, 1.0 / 8.0))
branch90 = float(lambda90) / (32.0 * pow(3.0, 1.0 / 8.0))
limit_branch = float(c0) / (32.0 * pow(3.0, 1.0 / 8.0))
sigma = Fraction(1, 2)
budget_branch90 = float((1 - sigma) * lambda90) / (32.0 * pow(3.0, 1.0 / 8.0))
budget_signed90 = budget_branch90 / 2.0

assert abs(branch90 - parent90 / 2.0) < 1e-20
assert limit_branch > branch90 > 0.0
assert abs(budget_branch90 - branch90 / 2.0) < 1e-20
assert abs(budget_signed90 - budget_branch90 / 2.0) < 1e-20

print("PASS: nested-rail host/death-plateau regressions")
print(f"parent90_D_quarter_constant={parent90:.12g}")
print(f"host_or_plateau90_constant={branch90:.12g}")
print(f"optimized_host_or_plateau_limit={limit_branch:.12g}")
print(f"budget_host_or_plateau90_constant={budget_branch90:.12g}")
print(f"budget_coherent_sign90_constant={budget_signed90:.12g}")
