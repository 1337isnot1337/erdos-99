#!/usr/bin/env python3
import math

HSTAR = math.sqrt(303.0) / 52.0
CSTAR = 0.129220199818177

assert HSTAR < 0.335
assert 1 + HSTAR < 1.335
assert abs(CSTAR/4 - 0.03230504995454425) < 1e-15
assert abs(CSTAR/8 - 0.016152524977272125) < 1e-15

# Terminal contact accounting for the only states that must be excluded before
# three gate edges have appeared.
for d in (4, 5):
    for k in (0, 1, 2):
        delta = k - (d - 2)
        if d == 4 and k == 2:
            assert delta == 0
            # Two edges cannot form a triangle; this is the connected-positive-
            # support contradiction case.
            assert k < 3
        else:
            assert delta < 0

# At most two absorption stages occur before either three edges have appeared
# or the terminal contradiction is invoked, so support-depth growth is O(1).
for stages in (0, 1, 2):
    additive_depth = stages * (0.5 + 1.0)
    assert additive_depth <= 3.0

print('degree-gate certificate: PASS')
print(f'h_*={HSTAR:.15f}')
print(f'c_*/8={CSTAR/8:.15f}')
