#!/usr/bin/env python3
"""Exact constants for the finite-defect common-transverse ladder through t<=1.8687."""
from fractions import Fraction as Q
from math import isqrt

def atan_inv_bounds(q,n):
    s=Q(0)
    for k in range(n):
        t=Q(1,(2*k+1)*q**(2*k+1))
        s += t if k%2==0 else -t
    nxt=Q(1,(2*n+1)*q**(2*n+1))
    return (s,s+nxt) if n%2==0 else (s-nxt,s)

def sqrt_bounds(lo,hi,scale):
    a=isqrt((lo.numerator*scale*scale)//lo.denominator)
    b=isqrt((hi.numerator*scale*scale)//hi.denominator)+1
    return Q(a,scale),Q(b,scale)

S=10**100
a5l,a5h=atan_inv_bounds(5,100)
a239l,a239h=atan_inv_bounds(239,30)
pi_lo,pi_hi=16*a5l-4*a239h,16*a5h-4*a239l
n3=isqrt(3*S*S)
s3l,s3h=Q(n3,S),Q(n3+1,S)
Dl,Dh=pi_lo/(2*s3h),pi_hi/(2*s3l)
sDl,_=sqrt_bounds(Dl,Dh,S)
C76_lo=2*sDl+Q(19,2500)

T=Q(18687,10000)
p=Q(1,5000)              # 0.0002 cleaned phase-zero path density
threshold_intercept=Q(5857,10000)

U0_hi=Q(9,2)*T-2*pi_lo
delta_max=(U0_hi-C76_lo)/2
length_floor=1-threshold_intercept/2-delta_max/2

# Global budgets on internal path boundaries:
# sum N <= 2*pi D;
# sum L <= 2*T_train <= (10T-4pi)D;
# sum D B <= 2D.
switch_upper=2*pi_hi
terminal_upper=10*T-4*pi_lo
complexity=switch_upper+terminal_upper+2
average=complexity/p

assert delta_max < Q(107,1000)
assert length_floor > Q(6535,10000)
assert terminal_upper < Q(6121,1000)
assert average < 72025

print('PASS: marker finite-defect common ladder through t<=1.8687')
for k,v in [
    ('delta max',delta_max),
    ('boundary-train crossing-neighbor floor',length_floor),
    ('terminal occurrence upper',terminal_upper),
    ('switch upper',switch_upper),
    ('joint complexity coefficient',complexity),
    ('average joint cost',average),
    ('margin to 72025',Q(72025)-average),
]:
    print(k,'=',float(v))
