#!/usr/bin/env python3
"""Exact certificate for the coupled adaptive paired-remainder O-O path through t<=1.868."""
from fractions import Fraction as Q
from math import factorial, isqrt


def atan_inv_bounds(q,n):
    s=Q(0)
    for k in range(n):
        term=Q(1,(2*k+1)*q**(2*k+1))
        s += term if k%2==0 else -term
    nxt=Q(1,(2*n+1)*q**(2*n+1))
    return (s,s+nxt) if n%2==0 else (s-nxt,s)


def sqrt_bounds(lo,hi,scale):
    a=isqrt((lo.numerator*scale*scale)//lo.denominator)
    b=isqrt((hi.numerator*scale*scale)//hi.denominator)
    return Q(a,scale),Q(b+1,scale)


def sin_bounds(x,n=30):
    s=Q(0)
    for k in range(n):
        term=x**(2*k+1)/factorial(2*k+1)
        s += term if k%2==0 else -term
    nxt=x**(2*n+1)/factorial(2*n+1)
    return (s,s+nxt) if n%2==0 else (s-nxt,s)


def F_bounds(z):
    slo,shi=sin_bounds(z/6)
    return z-6*shi,z-6*slo


a5l,a5h=atan_inv_bounds(5,110)
a239l,a239h=atan_inv_bounds(239,35)
pil,pih=16*a5l-4*a239h,16*a5h-4*a239l
SCALE=10**120
n3=isqrt(3*SCALE*SCALE)
s3l,s3h=Q(n3,SCALE),Q(n3+1,SCALE)
Dl,Dh=pil/(2*s3h),pih/(2*s3l)
sDl,_=sqrt_bounds(Dl,Dh,SCALE)
C707=2*sDl+Q(7707,10**6)

T=Q(467,250) # 1.868
U0lo=Q(9,2)*T-2*pih
U0hi=Q(9,2)*T-2*pil
dmax=(U0hi-C707)/2
assert dmax<Q(53,500) # .106
assert U0hi<Q(1062,500) # 2.124
assert 5*U0hi*U0hi<32*Dl

# Global corrected-feasibility floor z>2.0527, hence delta>0.0398.
z0=Q(20527,10000)
Flo,Fhi=F_bounds(z0)
d0=Q(199,5000) # .0398
assert Flo>d0
rmax=Q(107,100)
omd=Q(447,500) # .894
assert 1-dmax>omd
assert 1+rmax*rmax<4*omd*omd
Gd_lower=-6*(1+rmax)/(2*omd*omd)
assert Gd_lower>-Q(39,5)
assert z0*z0/72<Q(1,16)
Gz_lower=1-Q(1,16)/(2*omd)
assert Gz_lower>Q(24,25)
assert Q(24,25)-Q(39,5)*Q(1,16)>0

# H(z0)=G(F(z0),z0)<0.
Ulo=U0lo-2*Fhi
Uhi=U0hi-2*Flo
xlo=8*Dl-Uhi*Uhi
xhi=8*Dh-Ulo*Ulo
assert xlo>0
rootlo,_=sqrt_bounds(xlo,xhi,SCALE)
mlo=(Ulo+rootlo)/2
rhi=Uhi-mlo
p_hi=rhi*rhi/(2*(1-Fhi))
S_lo=pil-Uhi-T/2+mlo
H_hi=z0+p_hi-S_lo
assert H_hi<-Q(1,20000) # <-5e-5

# Also G(d0,z0)<0: anchor for the affine feasibility root.
Ulo0=U0lo-2*d0
Uhi0=U0hi-2*d0
xlo0=8*Dl-Uhi0*Uhi0
xhi0=8*Dh-Ulo0*Ulo0
rootlo0,_=sqrt_bounds(xlo0,xhi0,SCALE)
mlo0=(Ulo0+rootlo0)/2
rhi0=Uhi0-mlo0
Fzlo,Fzhi=F_bounds(z0)
p_hi0=(d0-Fzlo+rhi0*rhi0)/(2*(1-d0))
S_lo0=pil-Uhi0-T/2+mlo0
G0_hi=z0+p_hi0-S_lo0
assert G0_hi<-Q(1,25000) # <-4e-5

# Five exact detour bins certify G_delta<-1.3.
# For d in [a,b], U decreases. Bound r max at a, r/r' min at b.
edges=[d0+(Q(53,500)-d0)*Q(i,5) for i in range(6)]
for i in range(5):
    a,b=edges[i],edges[i+1]
    umax=U0hi-2*a
    umin=U0lo-2*b
    slo,_=sqrt_bounds(8*Dl-umax*umax,8*Dh-(U0lo-2*a)**2,SCALE)
    rrmax=(umax-slo)/2
    _,shi=sqrt_bounds(8*Dl-(U0hi-2*b)**2,8*Dh-umin*umin,SCALE)
    rrmin=(umin-shi)/2
    rpmin=(1+umin/shi)/2
    assert rrmin>=0 and rpmin>1
    N_hi=1+rrmax*rrmax-4*rpmin*(1-b)*(rrmin+1-b)
    assert N_hi<0
    Gd_hi=N_hi/(2*(1-a)*(1-a))
    assert Gd_hi<-Q(13,10)

# Since 0<G_z<1, the feasible root rises faster than 1.3.
s=Q(13,10)
# Thus z >= zline(d)=z0+s(d-d0).
dcap=Q(53,500)
lamlo=Q(483,1000)
rhs=2-dcap-lamlo
assert rhs>0 and rhs*rhs>2-dcap*dcap # lambda_*(d)>.483

# Along the affine line, rem=2U0-zline-4d lies in (0,2.04).
zcap=z0+s*(dcap-d0)
rem_hi=2*U0hi-z0-4*d0
rem_lo=2*U0lo-zcap-4*dcap
assert rem_lo>0 and rem_hi<Q(51,25) #2.04
# F'(rem)<=rem^2/72<.058.
fpmax=Q(29,500)
assert Q(51,25)**2/72<fpmax
# L is increasing in z because 1-F'/lambda>0.
assert fpmax<lamlo
# Along zline, L'(d)>0.138 using |lambda'|<1 and A=d-F(rem)<=d.
Lprime_lo=Q(33,10)-(1+Q(53,10)*fpmax)/lamlo-dcap/(lamlo*lamlo)
assert Lprime_lo>Q(13,100)

# Boundary paired-remainder lower bound at d=d0, z=z0.
# lambda_*(d0)>.546.
lam0lo=Q(273,500)
rhs0=2-d0-lam0lo
assert rhs0>0 and rhs0*rhs0>2-d0*d0
P_lo=z0-U0hi+2*d0
assert P_lo>0
rem0_lo=2*U0lo-z0-4*d0
rem0_hi=2*U0hi-z0-4*d0
assert rem0_lo>0
Frem_lo,Frem_hi=F_bounds(rem0_lo)
A_hi=d0-Frem_lo
assert A_hi>0
L0_lo=P_lo-A_hi/lam0lo
assert L0_lo>Q(7,1000)
phase=L0_lo/3
assert phase>Q(23,10000) # >.0023 in one phase
avg=2*Q(355,113)/Q(23,10000)
assert avg<2732

print('PASS coupled adaptive paired-remainder path through t<=1.868')
print('delta max =',float(dmax))
print('F(2.0527) lower =',float(Flo))
print('H(2.0527) upper =',float(H_hi))
print('G(0.0398,2.0527) upper =',float(G0_hi))
print('affine low-energy derivative floor =',float(Lprime_lo))
print('boundary pair floor =',float(P_lo))
print('boundary residual mass =',float(rem0_lo))
print('boundary residual bathtub floor =',float(Frem_lo))
print('low-energy pair floor =',float(L0_lo))
print('one-phase path floor =',float(phase))
print('switch average upper using .0023 =',float(avg))
