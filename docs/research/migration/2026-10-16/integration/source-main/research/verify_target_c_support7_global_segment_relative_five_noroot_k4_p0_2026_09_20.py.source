#!/usr/bin/env python3
"""Exact t=5, k=4, p=0 rank-density barrier for Target C.

For fixed rank-one coefficient-constraint line P, the canonical p=0 state
empties every touched root-0 quotient block whose empty constraint lies in P
and completes every other touched block.  Any other p=0 realization with the
same P completes some of these compatible empty blocks.  While P stays fixed,
each such completion adds three selected rows and one Q-relation dimension, so
delta can rise by at most one and the defect |A|-3 delta cannot decrease.

If C is the canonical complete-block set, c=|C| and d=c-rank_T(C), then
    delta <= rank_T(C)+4,
so
    |A|-3 delta >= 3d-7.
Thus d>=3 is automatic.  The ambient delta<=15 bound also makes c>=14
automatic.  The exact scan leaves 299 d=2 states; all have defect 11.
"""
from collections import Counter
from pathlib import Path
import contextlib
import importlib.util
import io

HERE = Path(__file__).resolve().parent
BASE = HERE / "verify_target_c_support7_global_segment_relative_five_noroot_k3_p0_2026_09_20.py"
spec = importlib.util.spec_from_file_location("relative_five_noroot_k4p0_base", BASE)
B = importlib.util.module_from_spec(spec)
with contextlib.redirect_stdout(io.StringIO()):
    spec.loader.exec_module(B)
R = B.R
K = B.K


def relation_rows_line(ext, touched, states, line):
    rows = []
    for block, state in zip(touched, states):
        if state == 7:
            rows.append(B.COMPLETE_T[block])
    alphas = R.nullspace_int(line, 5)
    assert len(alphas) == 4
    for alpha in alphas:
        tv = [sum(alpha[i] * R.MCOORD[e][70 + j] for i, e in enumerate(ext)) for j in range(15)]
        for block, state in zip(touched, states):
            vx = sum(alpha[i] * R.QCOMP[e][block][0] for i, e in enumerate(ext))
            vy = sum(alpha[i] * R.QCOMP[e][block][1] for i, e in enumerate(ext))
            beta = R.solve_local_coeffs_int(R.STATES[state][0], (-vx, -vy))
            ids = R.BLOCKS[block]
            for local_index, coeff in enumerate(beta):
                if coeff:
                    for j in range(15):
                        tv[j] += coeff * R.MCOORD[ids[local_index]][70 + j]
        rows.append(tuple(tv))
    return rows


def main():
    assert R.lucas_lehmer_127()
    keys, orbits, orbit_sizes, augmentation_candidates = K.five_no_root_orbits()
    assert len(orbits) == 20451
    assert sum(orbit_sizes) == 96560646
    assert augmentation_candidates == 20475
    key_to_global = {K.cycle_key(R.DESC[e]): e for e in R.NO_ROOT}

    complete_rank_cache = {}
    canonical_count = 0
    screen = Counter()
    exact_rank = Counter()
    exact_defect = Counter()
    max_norm2 = 0
    first_negative = None

    for local_five in orbits:
        ext = tuple(key_to_global[keys[i]] for i in local_five)
        touched = tuple(sorted(b for b in range(35) if any(R.QCOMP[e][b] != (0, 0) for e in ext)))
        lines = tuple(sorted({
            key
            for block in touched
            for key in (R.local_constraint_key(ext, block, 0),)
            if len(key) == 1
        }, key=repr))
        for line in lines:
            states = []
            generated = False
            for block in touched:
                key = R.local_constraint_key(ext, block, 0)
                if R.is_subspace(key, line):
                    states.append(0)
                    generated = generated or key == line
                else:
                    states.append(7)
            assert generated
            states = tuple(states)
            canonical_count += 1
            complete_set = tuple(b for b, state in zip(touched, states) if state == 7)
            c = len(complete_set)
            if c >= 14:
                screen["dimension_cap"] += 1
                continue
            rank = complete_rank_cache.get(complete_set)
            if rank is None:
                rank = R.rank_mod([B.COMPLETE_T[b] for b in complete_set])
                complete_rank_cache[complete_set] = rank
            deficiency = c - rank
            screen[deficiency] += 1
            if deficiency >= 3:
                continue
            rows = relation_rows_line(ext, touched, states, line)
            for row in rows:
                max_norm2 = max(max_norm2, sum(x * x for x in row))
            delta = R.rank_mod(rows)
            defect = 5 + 3 * c - 3 * delta
            exact_rank[(c, rank, delta)] += 1
            exact_defect[defect] += 1
            if defect < 0:
                first_negative = (defect, delta, ext, touched, line, states)
                break
        if first_negative is not None:
            break

    assert first_negative is None, first_negative
    assert canonical_count == 111822
    assert dict(sorted(screen.items(), key=lambda item: repr(item[0]))) == {
        "dimension_cap": 74157,
        2: 299,
        3: 12192,
        4: 24539,
        5: 635,
    }
    assert dict(sorted(exact_rank.items())) == {
        (7, 5, 5): 104,
        (8, 6, 6): 186,
        (9, 7, 7): 2,
        (10, 8, 8): 7,
    }
    assert dict(exact_defect) == {11: 299}
    assert max_norm2 == 14
    assert R.P * R.P > max(12, max_norm2) ** 15

    print("PASS: five-no-root k=4,p=0 rank-density branch")
    print("canonical_states", canonical_count)
    print("screen_census", dict(sorted(screen.items(), key=lambda item: repr(item[0]))))
    print("exact_rank_census", dict(sorted(exact_rank.items())))
    print("exact_defect_census", dict(sorted(exact_defect.items())))
    print("max_relation_row_norm_squared", max_norm2)
    print("hadamard_exact_rank_bound", R.P * R.P > max(12, max_norm2) ** 15)


if __name__ == "__main__":
    main()
