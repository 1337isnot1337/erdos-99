int run(){init();if(!ll())return 10;if((long long)MOD*MOD<=14348907LL)return 11;vector<long long>exp={1,1,4,14,61,268,1283,6032,27763};unordered_set<Multiset,MH>reps;Multiset e;reps.insert(e);for(int sz=1;sz<=8;sz++){unordered_set<Multiset,MH>n;n.reserve(reps.size()*8);for(auto&ms:reps){int mult[35]={};for(int i=0;i<ms.n;i++)mult[ms.a[i]]++;for(int s=0;s<35;s++)if(mult[s]<3){Multiset x=ms;x.a[x.n++]=s;sort(x.a.begin(),x.a.begin()+x.n);n.insert(canon(x));}}reps.swap(n);if((long long)reps.size()!=exp[sz])return 12;}long long all=0,pairs=0,places=0,passes=0,surv=0;for(auto&ms:reps){all++;uint64_t T;auto data=bdata(ms,T);for(int i=0;i<8;i++)for(int j=i+1;j<8;j++){pairs++;uint16_t M=(1u<<i)|(1u<<j);if(survivor(data,T,M,places,passes)){surv++;goto next;}}next:;}cout<<"all "<<all<<"\npairtests "<<pairs<<"\nplacements "<<places<<"\nstructural_pass "<<passes<<"\nsurvivors "<<surv<<"\n";return(all==27763&&pairs==777364&&places==2393667&&passes==0&&surv==0)?0:20;}
