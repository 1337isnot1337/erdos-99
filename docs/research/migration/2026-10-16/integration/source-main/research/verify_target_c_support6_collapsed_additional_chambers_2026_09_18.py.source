#!/usr/bin/env python3
"""Exact contraction certificates for two additional collapsed support-six chambers.

The six-face collapsed closure has ten variable train angles after fixing the two
angles on ``(0,1)`` and ``(0,2)``.  This verifier uses rational Taylor enclosures
and a rational approximate inverse of the ten-by-ten closure Jacobian.  It proves
that each recorded center contains a unique zero in a radius ``10^-10`` box, then
certifies the strict cyclic order and the local pentagon turn inequalities.

This is deliberately a local certificate.  It does not classify all closure
solutions or prove global source embedding, train integrability, diameter locking,
or minimum-diameter optimality.
"""

from fractions import Fraction as Q
from math import factorial

EDGES = ((0, 1), (0, 2), (0, 4), (0, 5), (1, 2), (1, 3),
         (1, 5), (2, 3), (2, 4), (3, 4), (3, 5), (4, 5))
FIXED_EDGES = ((0, 1), (0, 2))
VAR_EDGES = tuple(e for e in EDGES if e not in FIXED_EDGES)
SIGNS = (1, 1, 1, -1, -1, -1)
R = Q(1, 10**10)


def iadd(a, b):
    return (a[0] + b[0], a[1] + b[1])


def isub(a, b):
    return (a[0] - b[1], a[1] - b[0])


def smul(c, a):
    return (c * a[0], c * a[1]) if c >= 0 else (c * a[1], c * a[0])


def absup(a):
    return max(abs(a[0]), abs(a[1]))


def sincos_interval(x, n=45):
    s = Q(0)
    c = Q(0)
    for k in range(n + 1):
        s += (-1 if k & 1 else 1) * x ** (2 * k + 1) / factorial(2 * k + 1)
        c += (-1 if k & 1 else 1) * x ** (2 * k) / factorial(2 * k)
    rs = abs(x) ** (2 * n + 2) / factorial(2 * n + 2)
    rc = abs(x) ** (2 * n + 1) / factorial(2 * n + 1)
    return (s - rs, s + rs), (c - rc, c + rc)


def atan_inv_interval(n, terms):
    x = Q(1, n)
    s = Q(0)
    for k in range(terms):
        s += (-1 if k & 1 else 1) * x ** (2 * k + 1) / (2 * k + 1)
    nxt = (-1 if terms & 1 else 1) * x ** (2 * terms + 1) / (2 * terms + 1)
    return (min(s, s + nxt), max(s, s + nxt))


a5 = atan_inv_interval(5, 40)
a239 = atan_inv_interval(239, 12)
PI = (16 * a5[0] - 4 * a239[1], 16 * a5[1] - 4 * a239[0])
assert PI[0] > Q(333, 106) and PI[1] < Q(355, 113)
TWO_PI = smul(Q(2), PI)


# The first two entries in each center are the fixed angles.  All decimal data
# are exact rationals; the matrices are rational truncations of numerical inverse
# Jacobians, and the interval residual/Jacobian test below absorbs their error.
