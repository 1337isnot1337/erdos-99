def matvec_interval(matrix, vector):
    out = []
    for row in matrix:
        z = (Q(0), Q(0))
        for c, a in zip(row, vector):
            z = iadd(z, smul(c, a))
        out.append(z)
    return out


def certify(name, case):
    center = dict(zip(EDGES, case["center"]))
    fixed = {e: center[e] for e in FIXED_EDGES}
    C = tuple(tuple(Q(x) for x in line.split(","))
              for line in case["C"].strip().splitlines())
    assert len(C) == 10 and all(len(row) == 10 for row in C)

    SC = {e: sincos_interval(center[e]) for e in EDGES}
    FV = []
    for i in range(5):
        fx = (Q(SIGNS[i]), Q(SIGNS[i]))
        fy = (Q(0), Q(0))
        for e in EDGES:
            u, v = e
            if i == u:
                sg = 1
            elif i == v:
                sg = -1
            else:
                continue
            si, ci = SC[e]
            fx = iadd(fx, smul(Q(sg), ci))
            fy = iadd(fy, smul(Q(sg), si))
        FV.extend((fx, fy))

    J = [[(Q(0), Q(0)) for _ in range(10)] for __ in range(10)]
    for col, e in enumerate(VAR_EDGES):
        si, ci = SC[e]
        u, v = e
        for i in (u, v):
            if i >= 5:
                continue
            sg = Q(1 if i == u else -1)
            J[2 * i][col] = smul(-sg, si)
            J[2 * i + 1][col] = smul(sg, ci)

    Y = max(absup(z) for z in matvec_interval(C, FV))
    ZMAT = []
    for i in range(10):
        row = []
        for j in range(10):
            z = (Q(1 if i == j else 0), Q(1 if i == j else 0))
            for k in range(10):
                z = isub(z, smul(C[i][k], J[k][j]))
            row.append(z)
        ZMAT.append(row)
    Z0 = max(sum(absup(a) for a in row) for row in ZMAT)
    CN = max(sum(abs(c) for c in row) for row in C)
    Z = Z0 + 4 * CN * R
    assert Z < 1 and Y + Z * R < R

    root_angle = {
        e: ((center[e] - R, center[e] + R) if e in VAR_EDGES
            else (center[e], center[e]))
        for e in EDGES
    }

    def raw_angle(i, e):
        u, v = e
        a = root_angle[e]
        if i == u:
            return a
        if i == v:
            return iadd(a, PI)
        raise ValueError(e)

    def midpoint(a):
        return (a[0] + a[1]) / 2

    orders = []
    for i in range(6):
        values = [((Q(0), Q(0)) if SIGNS[i] > 0 else PI, "anchor")]
        for e in EDGES:
            if i not in e:
                continue
            a = raw_angle(i, e)
            candidates = []
            for k in range(-2, 3):
                b = iadd(a, smul(Q(2 * k), PI))
                if b[0] >= 0 and b[1] < TWO_PI[0]:
                    candidates.append(b)
            assert len(candidates) == 1
            values.append((candidates[0], str(e)))
        values.sort(key=lambda z: midpoint(z[0]))
        assert all(values[j][0][1] < values[j + 1][0][0]
                   for j in range(4))
        gaps = [isub(values[j + 1][0], values[j][0]) for j in range(4)]
        gaps.append(isub(iadd(values[0][0], TWO_PI), values[-1][0]))
        assert all(g[0] > 0 for g in gaps)
        assert 3 * max(g[1] for g in gaps) < 2 * PI[0]
        assert max((iadd(gaps[j], gaps[(j + 1) % 5]))[1]
                   for j in range(5)) < PI[0]
        orders.append(tuple(label for _interval, label in values))

    print(name, "Y", float(Y), "Z", float(Z),
          "margin", float(R - Y - Z * R))
    print(name, "face_orders", orders)
    return {"Y": Y, "Z": Z, "orders": tuple(orders), "center": center}


CERTIFIED = {name: certify(name, case) for name, case in CASES.items()}
print("PASS: exact additional collapsed support-six chamber certificates")
