import math
import random

h = math.sqrt(303.0) / 52.0
margin = math.sqrt(2.0) - 1.0 - h
assert margin > 0.0

# Finite threshold after which 1 + h_* + D^(-1/3) < sqrt(2).
D0 = math.ceil(margin ** -3)
assert 1.0 + h + D0 ** (-1.0 / 3.0) <= math.sqrt(2.0) + 1e-12
assert 1.0 + h + (10 * D0) ** (-1.0 / 3.0) < math.sqrt(2.0)

# Synthetic law-of-cosines regression: if a convex-quadrilateral angle is >= pi/2
# and its adjacent source sides are >=1, the opposite diagonal is >=sqrt(2).
rng = random.Random(20260917)
for _ in range(100000):
    r = 1.0 + 5.0 * rng.random()
    s = 1.0 + 5.0 * rng.random()
    theta = math.pi / 2.0 + (math.pi / 2.0 - 1e-9) * rng.random()
    diag2 = r * r + s * s - 2.0 * r * s * math.cos(theta)
    assert diag2 >= 2.0 - 1e-12

# Sharpness: unit square has crossing diagonals exactly sqrt(2).
side = 1.0
diag = math.hypot(side, side)
assert abs(diag - math.sqrt(2.0)) < 1e-15

print('PASS: sub-sqrt(2) source-pair graph planarity arithmetic')
print(f'h_*={h:.15f}')
print(f'sqrt(2)-1-h_*={margin:.15f}')
print(f'finite D threshold={D0}')
