#!/usr/bin/env python3
"""Exact certificate for branch-adaptive physical pentagon closure secants.

Combines the previously proved median-low/high rank intervals with exact rational
upper certificates for the sharp two-gap closure function M. Convexity of M
then gives a stronger rational chord on every branch-specific rank interval.
No floating-point arithmetic is used for acceptance.
"""
from fractions import Fraction as Q
import math


def atan_bounds(inv, n):
    x = Q(1, inv)
    s = Q(0)
    for k in range(n + 1):
        s += (-1 if k & 1 else 1) * x ** (2*k + 1) / Q(2*k + 1)
    nxt = x ** (2*n + 3) / Q(2*n + 3)
    return (s - nxt, s) if n % 2 == 0 else (s, s + nxt)


l5, u5 = atan_bounds(5, 24)
l239, u239 = atan_bounds(239, 6)
PI_LO = 4 * (4*l5 - u239)
PI_HI = 4 * (4*u5 - l239)
assert Q(3) < PI_LO < PI_HI < Q(22, 7)
assert PI_HI - PI_LO < Q(1, 10**30)


def cos_lower_multiple(r, n=22):
    r = Q(r)
    assert 0 <= r <= Q(2, 3)
    x = r * PI_HI
    s = Q(0)
    xx = Q(1)
    fact = 1
    for k in range(n + 1):
        if k:
            xx *= x*x
            fact *= (2*k - 1) * (2*k)
        s += (-1 if k & 1 else 1) * xx / fact
    rem = x ** (2*n + 1) / math.factorial(2*n + 1)
    return s - rem


def certify_m_upper(t, u):
    """Certify M(t) <= u at a rational knot."""
    t, u = Q(t), Q(u)
    if t == 0:
        assert u >= Q(2, 3)
        return
    if t == Q(2, 5):
        # Exact value from the existing closure theorem.
        assert u >= Q(4, 5)
        return
    if t == Q(2, 3):
        assert u >= 1
        return
    q = 1 - u/Q(2)
    assert 0 < q < Q(2, 3)
    # M(t) <= u iff cos(q*pi)+cos(t*pi/2) >= 1/2.
    lower = cos_lower_multiple(q) + cos_lower_multiple(t/Q(2)) - Q(1, 2)
    assert lower > 0


# Existing endpoint enclosures are retained, and three new knots are added at
# branch-specific rank bounds 1/15, 4/15, and 3/5.
U = {
    Q(0): Q(2, 3),
    Q(1, 15): Q(670687, 10**6),
    Q(1, 6): Q(691443, 10**6),
    Q(4, 15): Q(728581, 10**6),
    Q(1, 3): Q(761437, 10**6),
    Q(2, 5): Q(4, 5),
    Q(1, 2): Q(867191, 10**6),
    Q(3, 5): Q(944043, 10**6),
    Q(2, 3): Q(1),
}
for t, u in U.items():
    certify_m_upper(t, u)


# Representative physical order x_a <= x_b <= x_c <= x_d <= x_e. These are
# the exact branchwise outer intervals already proved by the rank-threshold
# certificate, listed here by increasing rank.
LOW_INTERVALS = (
    (Q(0), Q(2, 5)),
    (Q(4, 15), Q(2, 5)),
    (Q(1, 3), Q(2, 5)),
    (Q(2, 5), Q(2, 3)),
    (Q(2, 5), Q(2, 3)),
)
HIGH_INTERVALS = (
    (Q(1, 15), Q(2, 5)),
    (Q(1, 6), Q(2, 5)),
    (Q(2, 5), Q(1, 2)),
    (Q(2, 5), Q(3, 5)),
    (Q(2, 5), Q(2, 3)),
)


def chord(a, b):
    m = (U[b] - U[a]) / (b - a)
    c = U[a] - m*a
    assert m*a + c == U[a]
    assert m*b + c == U[b]
    return m, c


LOW_LINES = tuple(chord(*ab) for ab in LOW_INTERVALS)
HIGH_LINES = tuple(chord(*ab) for ab in HIGH_INTERVALS)

EXPECTED_LOW = (
    (Q(1, 3), Q(2, 3)),
    (Q(214257, 400000), Q(585743, 1000000)),
    (Q(115689, 200000), Q(284311, 500000)),
    (Q(3, 4), Q(1, 2)),
    (Q(3, 4), Q(1, 2)),
)
EXPECTED_HIGH = (
    (Q(387939, 1000000), Q(1612061, 2500000)),
    (Q(325671, 700000), Q(1074329, 1750000)),
    (Q(67191, 100000), Q(132809, 250000)),
    (Q(144043, 200000), Q(255957, 500000)),
    (Q(3, 4), Q(1, 2)),
)
assert LOW_LINES == EXPECTED_LOW
assert HIGH_LINES == EXPECTED_HIGH


# Verify that each branch-adaptive line is no weaker than the old exact broad
# secant on its whole interval. Affine differences need only be checked at the
# two interval endpoints.
OLD_LOW = (Q(1, 3), Q(2, 3))
OLD_HIGH = (Q(3, 4), Q(1, 2))


def val(line, x):
    return line[0]*x + line[1]


for intervals, lines in ((LOW_INTERVALS, LOW_LINES), (HIGH_INTERVALS, HIGH_LINES)):
    for (a, b), line in zip(intervals, lines):
        old = OLD_LOW if b <= Q(2, 5) else OLD_HIGH
        assert val(line, a) <= val(old, a)
        assert val(line, b) <= val(old, b)

print("PASS")
print("new endpoint certificates: M(1/15)<=670687/1e6, M(4/15)<=728581/1e6, M(3/5)<=944043/1e6")
print("median-low lines:", LOW_LINES)
print("median-high lines:", HIGH_LINES)
