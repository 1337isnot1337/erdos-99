#!/usr/bin/env python3
"""Exact outward certificate for the phase-star residual-coupled floor t>=1.84306."""
from fractions import Fraction as Q
from math import factorial, isqrt


def atan_inv_bounds(q, n):
    s = Q(0)
    for k in range(n):
        term = Q(1, (2*k+1)*q**(2*k+1))
        s += term if k % 2 == 0 else -term
    nxt = Q(1, (2*n+1)*q**(2*n+1))
    return (s, s+nxt) if n % 2 == 0 else (s-nxt, s)


def sqrt_bounds(lo, hi, scale):
    a = isqrt((lo.numerator*scale*scale)//lo.denominator)
    b = isqrt((hi.numerator*scale*scale)//hi.denominator)
    return Q(a,scale), Q(b+1,scale)


def sin_bounds(x, n=24):
    s = Q(0)
    for k in range(n):
        term = x**(2*k+1)/factorial(2*k+1)
        s += term if k % 2 == 0 else -term
    nxt = x**(2*n+1)/factorial(2*n+1)
    return (s, s+nxt) if n % 2 == 0 else (s-nxt, s)


def F_bounds(z):
    slo, shi = sin_bounds(z/6)
    return z-6*shi, z-6*slo


# Exact pi/algebraic enclosures.
a5l,a5h = atan_inv_bounds(5,90)
a239l,a239h = atan_inv_bounds(239,25)
pi_lo,pi_hi = 16*a5l-4*a239h,16*a5h-4*a239l
SCALE = 10**90
n3 = isqrt(3*SCALE*SCALE)
s3l,s3h = Q(n3,SCALE),Q(n3+1,SCALE)
Klo,Khi = Q(2)/s3h,Q(2)/s3l
Delta_lo,Delta_hi = pi_lo/(2*s3h),pi_hi/(2*s3l)
slo,shi = sqrt_bounds(Delta_lo,Delta_hi,SCALE)
C534_lo,C534_hi = 2*slo+Q(534,100000),2*shi+Q(534,100000)

T = Q(92153,50000)  # 1.84306
Umax_lo = Q(9,2)*T-2*pi_hi
Umax_hi = Q(9,2)*T-2*pi_lo
delta_max_hi = (Umax_hi-C534_lo)/2


def m2_bounds(Ulo,Uhi):
    xlo = 8*Delta_lo-Uhi*Uhi
    xhi = 8*Delta_hi-Ulo*Ulo
    rlo,rhi = sqrt_bounds(xlo,xhi,SCALE)
    return (Ulo+rlo)/2,(Uhi+rhi)/2


def bootstrap_step(z):
    Flo,_ = F_bounds(z)
    Ulo = Umax_lo-2*Flo
    Uhi = Umax_hi-2*Flo
    mlo,_ = m2_bounds(Ulo,Uhi)
    rhi = Uhi-mlo
    Slo = pi_lo-Uhi-T/2+mlo
    p_hi = (delta_max_hi-Flo+rhi*rhi)/(2*(1-delta_max_hi))
    return Slo-p_hi,Flo,Uhi


# Stage A: generic energy/incidence bootstrap localizes every putative t<=T survivor
# to U<1.911, where the phase-star residual-stability lemma applies.
z_levels = [
    Q(0),
    Q(20782,10000),
    Q(21915,10000),
    Q(22098,10000),
    Q(22129,10000),
]
for i,z in enumerate(z_levels[:-1]):
    nxt,_,_ = bootstrap_step(z)
    assert nxt > z_levels[i+1]
    print(f'bootstrap {i} margin =', float(nxt-z_levels[i+1]))

Flo,_ = F_bounds(z_levels[-1])
Uhi = Umax_hi-2*Flo
assert Uhi < Q(1911,1000)

# Stage B: exact constants in the phase-star residual-stability estimate.
Ubar = Q(1911,1000)
mlo,_ = m2_bounds(Ubar,Ubar)
generic_residual_hi = Ubar-mlo
assert generic_residual_hi < Q(7,1000)

alpha = Q(2,29)
psi_slope_lo = Q(19,10)/3-alpha*(3*Ubar/4-Klo)
assert psi_slope_lo > Q(61,100)

stability_factor = 1/(1-Q(7,1000)/(4*Q(61,100)))
assert stability_factor < Q(1003,1000)

h_hi = Ubar-C534_lo
assert h_hi < Q(104,100000)
assert delta_max_hi < Q(51,1000)

# Stage C: after the residual coupling, the feasibility margin is maximized at
# kappa=0 and h=U-C534=0. At that corner feasibility requires
# delta >= F(pi-t/2). Prove the reverse inequality at T=1.84306.
S_corner_lo = pi_lo-T/2
F_corner_lo,_ = F_bounds(S_corner_lo)
delta_corner_hi = (Q(9,2)*T-2*pi_lo-C534_lo)/2
corner_margin_lo = F_corner_lo-delta_corner_hi
assert corner_margin_lo > Q(2,1_000_000)

print('U upper after bootstrap =', float(Uhi))
print('generic residual upper at U=1.911 =', float(generic_residual_hi))
print('phase-star slope lower =', float(psi_slope_lo))
print('residual stability factor =', float(stability_factor))
print('h domain upper =', float(h_hi))
print('corner F lower =', float(F_corner_lo))
print('corner delta upper =', float(delta_corner_hi))
print('corner contradiction margin =', float(corner_margin_lo))
print('PASS: phase-star residual coupling forces t >= 1.84306')
