#!/usr/bin/env python3
"""Exact rational certificate for the metric quadruple-small adjacent-cut theorem."""

from fractions import Fraction as Q

# Exact path-density and lower-phase-neighbor constants from the audited
# triple-small adjacent-cut theorem.
p = Q(278778993, 78216868750)
d_low = Q(9891, 62500)

# Standard outward enclosures used by the existing certificate stack.
pi_up = Q(355, 113)
sqrt3_up = Q(17321, 10000)
assert sqrt3_up * sqrt3_up > 3

C_phase_up = pi_up * pi_up * sqrt3_up * (2 + sqrt3_up) / 12

# Existing three-budget total coefficient:
#   sum_i [N_i + D B_i + D(q_i+q_{i+1})]
# <= base_total * D + o(D).
base_total = 2 * pi_up + 2 + 2 * C_phase_up / d_low
base_average = base_total / p
assert base_average < Q(21200)

# A train midpoint-centerline segment through one strict unit rhombus has length 1
# and advances more than sqrt(3)/2 in the canonical height.  Use the simple exact
# lower enclosure sqrt(3) > 433/250 = 1.732.
sqrt3_low = Q(433, 250)
assert sqrt3_low * sqrt3_low < 3
train_length_coeff_up = 2 / sqrt3_low

# Add 100 times the center-train arclength gap as a fourth nonnegative budget.
weight = Q(100)
combined_average = base_average + weight * train_length_coeff_up / p

assert combined_average < Q(54000)
assert combined_average / weight < Q(540)

print("PASS: metric quadruple-small adjacent pair")
print("path density p =", float(p))
print("base three-budget average =", float(base_average))
print("train arclength coefficient upper =", float(train_length_coeff_up))
print("combined average =", float(combined_average))
print("54000 slack =", float(Q(54000) - combined_average))
print("arclength bound =", float(combined_average / weight))
print("540 arclength slack =", float(Q(540) - combined_average / weight))
