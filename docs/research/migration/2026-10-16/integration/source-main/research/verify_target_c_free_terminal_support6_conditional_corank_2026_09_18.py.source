#!/usr/bin/env python3
"""Exact coefficient and terminal-constant check for the conditional support-six step."""

from fractions import Fraction
from math import isqrt

Q = Fraction

for a in range(12):
    for x_A in range(12):
        for n_0 in range(12):
            for n_1 in range(12):
                for n_2 in range(12):
                    f = a + n_0 + n_1 + n_2
                    sigma = 2 * n_0 + n_2 + Q(n_1, 7)
                    E = a + Q(x_A, 2) + Q(n_0 + n_2, 2)
                    rhs = Q(f, 7) + Q(26, 7) * E
                    assert rhs - sigma == Q(27 * a + 13 * x_A + 7 * n_2, 7)
                    assert sigma <= rhs


def atan_inv_bounds(q: int, terms: int):
    s = Q(0)
    for k in range(terms):
        term = Q(1, (2 * k + 1) * q ** (2 * k + 1))
        s += term if k % 2 == 0 else -term
    nxt = Q(1, (2 * terms + 1) * q ** (2 * terms + 1))
    return (s, s + nxt) if terms % 2 == 0 else (s - nxt, s)


DIGITS = 90
SCALE = 10**DIGITS
a5_lo, a5_hi = atan_inv_bounds(5, 100)
a239_lo, a239_hi = atan_inv_bounds(239, 30)
pi_hi = 16 * a5_hi - 4 * a239_lo
n3 = isqrt(3 * SCALE * SCALE)
sqrt3_lo = Q(n3, SCALE)
assert sqrt3_lo * sqrt3_lo < 3
delta2_hi = pi_hi / (2 * sqrt3_lo)
s2_num = isqrt((delta2_hi.numerator * SCALE * SCALE) // delta2_hi.denominator) + 1
s2_hi = Q(s2_num, SCALE)
assert s2_hi * s2_hi >= delta2_hi

Mstar_hi = 4 * s2_hi + Q(7707, 10**6) * 2
f_density_hi = Mstar_hi / 5 + 2 * Q(71, 10000)
sigma_density_hi = f_density_hi / 7
assert sigma_density_hi < Q(111304721, 10**9)

print("PASS: conditional support-six corank certificate")
print("f_density_upper", float(f_density_hi))
print("pair_floor_sigma_density_upper", float(sigma_density_hi))
