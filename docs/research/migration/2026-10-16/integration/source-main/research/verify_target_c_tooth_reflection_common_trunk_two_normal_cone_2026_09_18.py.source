#!/usr/bin/env python3
"""Regression checks for the compatible common-trunk two-normal cone theorem."""

from __future__ import annotations

import math


def dot(a: tuple[float, float], b: tuple[float, float]) -> float:
    return a[0] * b[0] + a[1] * b[1]


def check_cones() -> None:
    # Dense angular regression of the two exact half-plane implications.
    for theta in (0.02, 0.1, 0.4, 1.0, 2.0):
        a = theta / 2.0
        n1 = (math.cos(a), math.sin(a))
        n2 = (math.cos(a), -math.sin(a))
        b = (1.0, 0.0)
        t = (0.0, 1.0)

        for k in range(20_000):
            phi = -math.pi + 2.0 * math.pi * (k + 0.5) / 20_000
            u = (math.cos(phi), math.sin(phi))
            d1 = dot(u, n1)
            d2 = dot(u, n2)

            if d1 > 1e-12 and d2 > 1e-12:
                assert dot(u, b) > math.sin(a) - 2e-4

            if d1 > 1e-12 and d2 < -1e-12:
                assert dot(u, t) > math.cos(a) - 2e-4
                # The individual-normal sin(theta) estimate is valid only
                # through right-angle normal separation.  For obtuse theta,
                # the opposite cone can contain N1 itself.
                if theta <= math.pi / 2.0:
                    assert d1 < math.sin(theta) + 2e-4
                    assert -d2 < math.sin(theta) + 2e-4
                else:
                    assert d1 <= 1.0 + 2e-12
                    assert -d2 <= 1.0 + 2e-12


def check_tuned_small_external_scaling() -> None:
    # In terms of R=D^(1/4)/sqrt(Z+1):
    # m~R^(1/2), q~R^(3/2), s~R^(3/4), theta~R^(-1/4).
    for r in (1e4, 1e8, 1e12):
        m = r**0.5
        q = r**1.5
        s = q**0.5
        theta = r**-0.25

        same_span_scale = s * theta
        opposite_span_scale = s

        assert math.isclose(m, r**0.5, rel_tol=1e-12)
        assert math.isclose(s, r**0.75, rel_tol=1e-12)
        assert math.isclose(same_span_scale, r**0.5, rel_tol=1e-12)
        assert math.isclose(opposite_span_scale, r**0.75, rel_tol=1e-12)
        assert q - 1 > r**1.49


def check_kappa_admissibility() -> None:
    # Model Z=D^p with every p<1/2. The tuned kappa exponent is 1/8+p/4,
    # strictly below 1/4, while m exponent is 1/8-p/4>0.
    for p in (0.0, 0.1, 0.25, 0.4, 0.49):
        kappa_exp = 0.125 + p / 4.0
        m_exp = 0.125 - p / 4.0
        assert kappa_exp < 0.25
        assert m_exp > 0.0


def main() -> None:
    check_cones()
    check_tuned_small_external_scaling()
    check_kappa_admissibility()
    print("PASS: common-trunk two-normal cone and tuned scaling certificate")


if __name__ == "__main__":
    main()
