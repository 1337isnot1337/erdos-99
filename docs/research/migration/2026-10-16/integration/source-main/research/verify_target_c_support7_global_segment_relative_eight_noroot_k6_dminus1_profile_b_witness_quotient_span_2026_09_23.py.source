#!/usr/bin/env python3
"""Global quotient-span filter for the remaining Profile B touch-three witnesses.

The rank-loss-robust pair theorem is local to a pair of distinguished
active aligned touch-three witnesses. This wrapper adds a global fact: the
images of all such witnesses in V/L must span at least two dimensions.

Why: the previous finite Case-A/Case-B censuses already exclude, in the
presence of a touch-three witness, (i) two aligned touch-four blocks and
(ii) one aligned touch-four block together with the unique possible rank-two
singleton block. Since there is at most one rank-two singleton block, there
is therefore at most one dependency-active chosen block outside the
active-touch-three witness set. The nine source classes span V and dim(V/L)=3,
so the witness images cannot all lie on one projective line.

Consequences enforced here:
  * witness quotient rank rho_W is 2 or 3;
  * at least one witness pair has quotient increment two, hence its union
    puncture has deficiency at most one by the preceding rank-loss theorem;
  * if rho_W=2, there is exactly one active non-witness source class and it
    supplies the third quotient direction;
  * if rho_W=3, every quotient-independent witness triple has union-puncture
    deficiency zero. The wrapper checks this directly against canonical_state.
"""

from collections import Counter
from itertools import combinations
from pathlib import Path
import contextlib
import importlib.util
import io

HERE = Path(__file__).resolve().parent
BASE = HERE / "verify_target_c_support7_global_segment_relative_eight_noroot_k6_dminus1_profile_b_double_touch3_rankloss_cancellation_2026_09_23.py"
spec = importlib.util.spec_from_file_location("e99_profile_b_rankloss", BASE)
C = importlib.util.module_from_spec(spec)
with contextlib.redirect_stdout(io.StringIO()):
    spec.loader.exec_module(C)

M = C.M
K = C.K
T = C.T
D = C.D

ORIG_CHOSEN_PASSES_RANKLOSS = M.chosen_passes_all_clean_fans
WITNESS_SPAN_COUNTS = Counter()
WITNESS_SPAN_EXAMPLES = []


def witness_quotient_span_ok(ext8, space8, rank_cache, block_states):
    data = D.reconstruct_witnesses(ext8, space8, block_states)
    if data is None:
        WITNESS_SPAN_COUNTS["witness_reconstruction_failed"] += 1
        return False
    L, _one_kernels, witnesses = data

    if len(L) != 6 or len(witnesses) < 2:
        WITNESS_SPAN_COUNTS[("bad_base_dimensions", len(L), len(witnesses))] += 1
        return False

    witness_indices = {w[0] for w in witnesses}
    witness_vectors = tuple(w[5] for w in witnesses)
    witness_span = K.span_basis(
        L,
        *((v,) for v in witness_vectors),
        width=9,
    )
    rho_w = len(witness_span) - len(L)
    if rho_w not in (2, 3):
        WITNESS_SPAN_COUNTS[("bad_witness_quotient_rank", rho_w)] += 1
        return False

    active_nonwitness = []
    for basis_index, (block, _state) in enumerate(block_states):
        if basis_index in witness_indices:
            continue
        e = D.source_basis_vector(basis_index)
        if K.is_subspace((e,), L, width=9):
            continue
        active_nonwitness.append((basis_index, block, e))

    # Prior exact source censuses imply that, once a touch-three witness exists,
    # the source cannot contain either two aligned touch-four singleton blocks
    # or a touch-four block together with a rank-two singleton block. Together
    # with the earlier at-most-one-rank-two theorem, there is at most one active
    # source class outside the touch-three witness set.
    if len(active_nonwitness) > 1:
        WITNESS_SPAN_COUNTS[("too_many_active_nonwitness", len(active_nonwitness))] += 1
        return False

    all_active_span = K.span_basis(
        witness_span,
        *((item[2],) for item in active_nonwitness),
        width=9,
    )
    if len(all_active_span) - len(L) != 3:
        WITNESS_SPAN_COUNTS[(
            "active_classes_do_not_span_quotient",
            rho_w,
            len(active_nonwitness),
            len(all_active_span) - len(L),
        )] += 1
        return False

    if rho_w == 2 and len(active_nonwitness) != 1:
        WITNESS_SPAN_COUNTS[("rank2_witness_span_wrong_complement", len(active_nonwitness))] += 1
        return False

    independent_pairs = []
    for wa, wb in combinations(witnesses, 2):
        rho_pair = len(K.span_basis(L, (wa[5],), (wb[5],), width=9)) - len(L)
        if rho_pair == 2:
            independent_pairs.append((wa, wb))
    if not independent_pairs:
        WITNESS_SPAN_COUNTS["missing_independent_witness_pair"] += 1
        return False

    # The imported rank-loss filter has already checked d_R<=1 for every such
    # pair, at every projected coefficient rank. Record the forced existence.
    WITNESS_SPAN_COUNTS[("independent_pair_count", len(independent_pairs))] += 1

    triple_records = []
    if rho_w == 3:
        independent_triples = []
        for triple in combinations(witnesses, 3):
            rho_triple = len(K.span_basis(
                L,
                *((w[5],) for w in triple),
                width=9,
            )) - len(L)
            if rho_triple == 3:
                independent_triples.append(triple)

        if not independent_triples:
            WITNESS_SPAN_COUNTS["rank3_span_missing_independent_triple"] += 1
            return False

        for triple in independent_triples:
            union = frozenset().union(*(w[2] for w in triple))
            if not (6 <= len(union) <= 8):
                WITNESS_SPAN_COUNTS[("bad_independent_triple_union_size", len(union))] += 1
                return False
            ext_u, space_u = M.delete_source_positions(
                ext8,
                space8,
                tuple(sorted(union)),
            )
            state_u = M.F.canonical_state(ext_u, space_u, rank_cache)
            if state_u is None:
                WITNESS_SPAN_COUNTS[("triple_union_canonical_state_failed", len(union), len(space_u))] += 1
                return False
            deficiency_u = state_u[1]
            if deficiency_u != 0:
                WITNESS_SPAN_COUNTS[(
                    "independent_triple_nonzero_deficiency",
                    len(union),
                    len(space_u),
                    deficiency_u,
                )] += 1
                return False
            triple_records.append((
                tuple(w[0] for w in triple),
                tuple(sorted(union)),
                len(space_u),
                deficiency_u,
            ))

        WITNESS_SPAN_COUNTS[("independent_triple_count", len(independent_triples))] += 1

    nonwitness_type = None
    if active_nonwitness:
        basis_index, block, _e = active_nonwitness[0]
        if T.is_aligned(ext8, block):
            touches = T.touch_positions(ext8, block)
            if len(touches) != 4:
                WITNESS_SPAN_COUNTS[("active_nonwitness_aligned_wrong_touch_count", len(touches))] += 1
                return False
            nonwitness_type = (basis_index, block, "touch4")
        else:
            nonwitness_type = (basis_index, block, "rank2")

    WITNESS_SPAN_COUNTS[("witness_quotient_rank", rho_w)] += 1
    WITNESS_SPAN_COUNTS["witness_quotient_span_pass"] += 1
    if len(WITNESS_SPAN_EXAMPLES) < 20:
        WITNESS_SPAN_EXAMPLES.append((
            tuple(ext8),
            space8,
            tuple(block_states),
            rho_w,
            tuple((w[0], w[1], tuple(sorted(w[2]))) for w in witnesses),
            nonwitness_type,
            tuple(triple_records),
        ))
    return True


def chosen_passes_witness_quotient_span(ext8, space8, rank_cache, block_states):
    if not ORIG_CHOSEN_PASSES_RANKLOSS(
        ext8,
        space8,
        rank_cache,
        block_states,
    ):
        return False
    return witness_quotient_span_ok(ext8, space8, rank_cache, block_states)


M.chosen_passes_all_clean_fans = chosen_passes_witness_quotient_span


if __name__ == "__main__":
    try:
        M.F.L.B.main()
    finally:
        print("global_lift_counts", M.F.L.GLOBAL_LIFT_COUNTS)
        print("fixed_nine_counts", M.F.FIXED_NINE_COUNTS)
        print("actual_realization_counts", M.A.ACTUAL_COUNTS)
        print("all_clean_counts", M.ALL_CLEAN_COUNTS)
        print("kernel_lattice_counts", K.KERNEL_LATTICE_COUNTS)
        print("touch3_kernel_counts", T.TOUCH3_KERNEL_COUNTS)
        print("double_touch3_union_counts", D.DOUBLE_TOUCH3_COUNTS)
        print("rankloss_cancellation_counts", C.RANKLOSS_COUNTS)
        print("witness_span_counts", WITNESS_SPAN_COUNTS)
        print("witness_span_examples", WITNESS_SPAN_EXAMPLES)
