#!/usr/bin/env python3
"""Arithmetic certificate for the degree-5/6 near-contact sensor-rank extension."""
from fractions import Fraction as Q
from math import isqrt


def atan_inv_bounds(q,n):
    s=Q(0)
    for k in range(n):
        term=Q(1,(2*k+1)*q**(2*k+1))
        s += term if k%2==0 else -term
    nxt=Q(1,(2*n+1)*q**(2*n+1))
    return (s,s+nxt) if n%2==0 else (s-nxt,s)


def sqrt_bounds(lo,hi,scale):
    a=isqrt((lo.numerator*scale*scale)//lo.denominator)
    b=isqrt((hi.numerator*scale*scale)//hi.denominator)
    return Q(a,scale),Q(b+1,scale)


a5l,a5h=atan_inv_bounds(5,90)
a239l,a239h=atan_inv_bounds(239,25)
pil,pih=16*a5l-4*a239h,16*a5h-4*a239l
SCALE=10**100
n3=isqrt(3*SCALE*SCALE)
s3l,s3h=Q(n3,SCALE),Q(n3+1,SCALE)
Dl,Dh=pil/(2*s3h),pih/(2*s3l)
sDl,_=sqrt_bounds(Dl,Dh,SCALE)
C707=2*sDl+Q(7707,1000000)


def f56_floor(T):
    return (Q(3)*C707/Q(2)+pil-Q(11)*T/Q(4))/Q(2)

rows=[
    (Q(2,1),        Q(51,10000)),
    (Q(41,20),      Q(37,10000)),
    (Q(21,10),      Q(235,100000)),
    (Q(43,20),      Q(97,100000)),
    (Q(109,50),     Q(15,100000)),
    (Q(10927,5000), Q(24,10000000)),
]
for T,claim in rows:
    F=f56_floor(T)
    face_family=F/Q(25)
    rank_floor=F/Q(50)
    assert face_family>0
    assert rank_floor>claim,(T,float(rank_floor),float(claim))
    print('T=',float(T),'vertex-disjoint faces/D >',float(face_family),
          'sensor rank/D >',float(rank_floor),'claim',float(claim))

print('PASS low-degree near-contact sensor-rank arithmetic')
