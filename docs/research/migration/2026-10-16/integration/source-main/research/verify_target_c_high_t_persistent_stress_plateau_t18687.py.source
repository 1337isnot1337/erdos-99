#!/usr/bin/env python3
"""Exact sanity checks for the persistent-stress plateau identities."""

from fractions import Fraction as Q

# A rational unit-vector toy persistent support.
# u=(1,0); the two oblique vectors are a symmetric 3-4-5 pair.
beta = [Q(1, 4), Q(1, 4), Q(1, 4)]
v = [
    (Q(1), Q(0)),
    (Q(3, 5), Q(4, 5)),
    (Q(3, 5), Q(-4, 5)),
]

for x, y in v:
    assert x * x + y * y == 1

p = sum(beta)
V = (
    sum(b * x for b, (x, y) in zip(beta, v)),
    sum(b * y for b, (x, y) in zip(beta, v)),
)
assert V[1] == 0 and V[0] > 0
a = V[0]

variance = Q(0)
for b, (x, y) in zip(beta, v):
    variance += b * ((x - 1) ** 2 + y * y)

assert p == Q(3, 4)
assert a == Q(11, 20)
assert p - a == Q(1, 5)
assert p - a == variance / 2

# Exact nested-start mass accounting.
B = [Q(1, 100), Q(1, 200), Q(1, 400)]
W = [p]
for q in B:
    W.append(W[-1] + q)

for j, w in enumerate(W):
    assert w - p == sum(B[:j])
assert max(w - p for w in W) == sum(B) == Q(7, 400)

# Exact first-moment perturbation check for unit switching directions.
switch = [
    (B[0], (Q(0), Q(1))),
    (B[1], (Q(-1), Q(0))),
    (B[2], (Q(0), Q(-1))),
]
cur = V
for j, (b, z) in enumerate(switch, start=1):
    cur = (cur[0] + b * z[0], cur[1] + b * z[1])
    dx = cur[0] - V[0]
    dy = cur[1] - V[1]
    bound = sum(B[:j])
    assert dx * dx + dy * dy <= bound * bound

print("PASS: persistent-stress plateau identities")
print("persistent mass p =", p)
print("persistent resultant magnitude a =", a)
print("dispersion currency p-a =", p - a)
print("nested added mass =", sum(B))
