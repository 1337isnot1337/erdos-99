#!/usr/bin/env python3
"""Exact side-certificate for the strict adaptive energy threshold in the t<=1.868 path theorem."""
from fractions import Fraction as Q

# lambda_*(d)=2-d-sqrt(2-d^2) is the lower equality root of
#   (1-d-lambda/2)^2 = lambda-lambda^2/4.
# The theorem selects lambda(d)=lambda_*(d)-1e-4.

d0=Q(199,5000)   # 0.0398
d1=Q(53,500)     # 0.106
eps=Q(1,10000)

# lambda_* is decreasing on this interval.  Prove lambda_*(d1)>0.4837,
# hence lambda(d)>0.4836>0.483 uniformly.
Lstar_lo=Q(4837,10000)
rhs=2-d1-Lstar_lo
assert rhs>0
assert rhs*rhs>2-d1*d1
assert Lstar_lo-eps>Q(483,1000)

# At the lower detour endpoint, lambda_*(d0)>0.5465, hence
# lambda(d0)>0.5464>0.546, preserving the boundary energy certificate.
L0star_lo=Q(5465,10000)
rhs0=2-d0-L0star_lo
assert rhs0>0
assert rhs0*rhs0>2-d0*d0
assert L0star_lo-eps>Q(273,500)

# Uniform upper bound: lambda_*(d0)<0.547.  Since lambda_* decreases,
# lambda(d)<0.547 throughout the interval.  This leaves a fixed positive
# separation between the two physical terminal arcs.
Lstar_hi=Q(547,1000)
rhshi=2-d0-Lstar_hi
assert rhshi>0
assert rhshi*rhshi<2-d0*d0

print('PASS strict adaptive threshold on 0.0398<=delta<=0.106')
print('lambda(delta) > 0.4836 uniformly')
print('lambda(0.0398) > 0.5464')
print('lambda(delta) < 0.547 uniformly')
