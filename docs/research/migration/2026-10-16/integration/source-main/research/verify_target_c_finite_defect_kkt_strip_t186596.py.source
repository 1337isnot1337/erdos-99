#!/usr/bin/env python3
"""Exact certificate for a finite-defect/KKT strip through t<=1.86596."""
from fractions import Fraction as Q


def atan_inv_bounds(q,n):
    s=Q(0)
    for k in range(n):
        term=Q(1,(2*k+1)*q**(2*k+1))
        s += term if k%2==0 else -term
    nxt=Q(1,(2*n+1)*q**(2*n+1))
    return (s,s+nxt) if n%2==0 else (s-nxt,s)


a5l,a5h=atan_inv_bounds(5,100)
a239l,a239h=atan_inv_bounds(239,30)
pi_lo,pi_hi=16*a5l-4*a239h,16*a5h-4*a239l

T=Q(46649,25000)       # 1.86596
path=Q(17,1000000)     # 0.000017

# Q/D <= 2t-pi, f<=Q, and 2*T_tr/D = 2t+4f/D.
Q_upper=2*T-pi_lo
terminal_upper=2*T+4*Q_upper

# Each actual diameter interval starts/stops at most twice, |H|<=pi D.
switch_upper=2*pi_hi

# Positive relative-interior KKT stress has sum beta=1 and each interval
# changes at most twice, so sum_i B_i<=2 and sum_i D B_i<=2D.
kkt_scaled_upper=Q(2)

complexity=terminal_upper+switch_upper+kkt_scaled_upper
ratio=complexity/path

assert Q_upper<Q(591,1000)
assert terminal_upper<Q(6094,1000)
assert switch_upper<Q(6284,1000)
assert complexity<Q(14377,1000)
assert ratio<845672

print('PASS: finite-defect KKT strip through t<=1.86596')
for k,v in [
    ('pi lower',pi_lo),('pi upper',pi_hi),('Q upper',Q_upper),
    ('terminal occurrence upper',terminal_upper),('switch upper',switch_upper),
    ('D*B global upper',kkt_scaled_upper),('combined complexity',complexity),
    ('average ratio',ratio),('margin to 845672',Q(845672)-ratio),
]: print(k,'=',float(v))
