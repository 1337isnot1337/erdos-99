#!/usr/bin/env python3
"""Arithmetic/regression checks for the two-normal shared FREE skeleton note.

The proof itself is in the accompanying markdown note. This script checks constants,
threshold algebra, and the slow-scale exponent conversions used there.
"""

from __future__ import annotations

import math


H_STAR = math.sqrt(303.0) / 52.0


def check_constants() -> None:
    alpha = 1.0 - H_STAR
    assert abs(alpha - 0.6652520156628998) < 1e-14
    assert abs(alpha / 11.0 - 0.06047745596935453) < 1e-14
    assert abs(alpha / 22.0 - 0.030238727984677263) < 1e-14
    assert abs(44.0 * H_STAR / alpha - 22.14034826509406) < 1e-12


def check_threshold_scaling() -> None:
    # R=floor(m/omega) has m/R ~ omega whenever omega->infinity and omega=o(m).
    for m, omega in ((10_000, 10), (1_000_000, 100), (10_000_000, 1000)):
        R = math.floor(m / omega)
        ratio = (m / R) / omega
        assert abs(ratio - 1.0) <= 1.0 / max(1, R)


def check_slow_scale_identities() -> None:
    # m ~ D^(1/4)/kappa implies the three scales used in TS.15--TS.17.
    for D, kappa in ((1e16, 10.0), (1e24, 100.0)):
        m = D ** 0.25 / kappa

        shared = D / (m * m)
        assert math.isclose(shared, kappa * kappa * D ** 0.5, rel_tol=1e-12)

        total_slack = 1.0 / (m * m)
        assert math.isclose(total_slack, kappa * kappa / D ** 0.5, rel_tol=1e-12)

        activation = m * m / D
        assert math.isclose(
            activation,
            1.0 / (kappa * kappa * D ** 0.5),
            rel_tol=1e-12,
        )


def check_markov_factor() -> None:
    # Two exceptional quarters leave at least half of a matching.
    for N in (100, 10_000, 1_000_000):
        exceptional_each = N / 4.0
        survivors = N - 2.0 * exceptional_each
        assert survivors == N / 2.0


def main() -> None:
    check_constants()
    check_threshold_scaling()
    check_slow_scale_identities()
    check_markov_factor()

    alpha = 1.0 - H_STAR
    print("PASS: two-normal shared FREE skeleton certificate")
    print(f"h_* = {H_STAR:.15f}")
    print(f"K=1 shared matching coefficient = {alpha/11.0:.15f}")
    print(f"K=1 both-lowtime coefficient = {alpha/22.0:.15f}")
    print(f"K=1 activation constant = {44.0*H_STAR/alpha:.15f}")


if __name__ == "__main__":
    main()
