#!/usr/bin/env python3
"""Exact finite certificate for generic-H6 all-root interior domination.

The geometric theorem is proved in the companion note. This verifier checks the
finite rooted-distance order counts and the size of the endpoint-choice cover.
No floating-point arithmetic is used.
"""
from collections import Counter
from itertools import permutations
from math import factorial

LABELS = tuple(range(1, 8))
assert factorial(7) == 5040


def one_target_ok(order, target, a, b):
    """Whether target is not later than both bracketing hull endpoints."""
    pos = {v: k for k, v in enumerate(order)}
    return not (pos[target] > pos[a] and pos[target] > pos[b])


def two_targets_ok(order, s6, s7):
    """Hull-root normal form with hull rays 1,2,3,4,5 and targets 6,7."""
    return (
        one_target_ok(order, 6, s6, s6 + 1)
        and one_target_ok(order, 7, s7, s7 + 1)
    )


# One target at an arbitrary root: among the relative orders of target and its
# two bracketing endpoints, exactly the two cases with an endpoint after target
# are permitted. Hence 2/3 of all strict seven-distance orders remain. Verify
# this exhaustively rather than relying only on the three-label argument.
for target, a, b in ((7, 1, 2), (6, 4, 5)):
    kept = sum(
        one_target_ok(order, target, a, b)
        for order in permutations(LABELS)
    )
    assert kept == 3360
    assert 3 * kept == 2 * factorial(7)


# Two interior targets at a hull root. The count depends only on whether their
# bracketing hull edges coincide, share one hull endpoint, or are disjoint.
counts = {}
for s6 in range(1, 5):
    for s7 in range(1, 5):
        counts[(s6, s7)] = sum(
            two_targets_ok(order, s6, s7)
            for order in permutations(LABELS)
        )

expected = {
    (1, 1): 2520,
    (1, 2): 2352,
    (1, 3): 2240,
    (1, 4): 2240,
    (2, 1): 2352,
    (2, 2): 2520,
    (2, 3): 2352,
    (2, 4): 2240,
    (3, 1): 2240,
    (3, 2): 2352,
    (3, 3): 2520,
    (3, 4): 2352,
    (4, 1): 2240,
    (4, 2): 2240,
    (4, 3): 2352,
    (4, 4): 2520,
}
assert counts == expected
assert Counter(counts.values()) == Counter({2240: 6, 2352: 6, 2520: 4})

for (s6, s7), count in counts.items():
    d = abs(s6 - s7)
    if d == 0:
        assert 2 * count == 5040
    elif d == 1:
        assert 15 * count == 7 * 5040
    else:
        assert 9 * count == 4 * 5040


# Two interior targets, each with every other reciprocal vertex as a possible
# root, give 7+7 ordered root-target pairs. Each exact domination theorem is
# covered by selecting one of two endpoint halfspaces.
root_target_pairs = 7 + 7
assert root_target_pairs == 14
assert 2 ** root_target_pairs == 16384
assert 4 ** 6 * 2 ** 2 == 16384  # six hull roots, two interior roots

print("PASS: generic-H6 all-root interior domination finite certificate")
print("root-target domination constraints:", root_target_pairs)
print("one-target strict rooted orders: 3360 / 5040 = 2/3")
print("two-target hull-root counts: distance 0 -> 2520, 1 -> 2352, 2/3 -> 2240")
print("closed endpoint-choice products: 2^14 = 16384")
