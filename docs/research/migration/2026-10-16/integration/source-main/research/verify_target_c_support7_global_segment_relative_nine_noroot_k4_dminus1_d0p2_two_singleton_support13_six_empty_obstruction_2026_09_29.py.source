#!/usr/bin/env python3
from collections import Counter
from itertools import combinations

import verify_target_c_support7_global_segment_relative_nine_noroot_k4_dminus1_d0p2_selected_pair_orientation_2026_09_28 as B

SUPPORT = [
    ((0, 1, 2, 3), 2),
    ((0, 1, 2, 4), 2),
    ((0, 1, 3, 4), 2),
    ((0, 2, 3, 4), 2),
    ((1, 2, 3, 4), 1),
]

EXPECTED = Counter({
    "orientations": 243,
    "six_subsets": 51030,
    "mod2_rank_7": 972,
    "mod2_rank_8": 1458,
    "mod2_rank_9": 48600,
})

def mod2_rank(rows):
    basis = [0] * 9
    rank = 0
    for x in rows:
        while x:
            p = x.bit_length() - 1
            if basis[p]:
                x ^= basis[p]
            else:
                basis[p] = x
                rank += 1
                break
    return rank

def main():
    census = Counter()
    for ext in B.oriented_exts(SUPPORT):
        census["orientations"] += 1
        touched = tuple(sorted({b for e in ext for b, v in enumerate(B.QCOMP[e]) if v != (0, 0)}))
        touched_mask = sum(1 << b for b in touched)
        assert len(touched) == 10
        assert B.h_rank(touched_mask) == 6
        rows_by_block = []
        for b in touched:
            vals = [B.QCOMP[e][b] for e in ext]
            x = sum((int(v[0]) & 1) << i for i, v in enumerate(vals))
            y = sum((int(v[1]) & 1) << i for i, v in enumerate(vals))
            rows_by_block.append((x, y))
        for six in combinations(range(10), 6):
            census["six_subsets"] += 1
            rows = []
            for j in six:
                rows.extend(rows_by_block[j])
            r = mod2_rank(rows)
            assert r >= 7
            census[f"mod2_rank_{r}"] += 1
    assert census == EXPECTED, census
    print("census", dict(census))
    print("PASS: every six empty-block spaces have mod-2 span rank at least 7")

if __name__ == "__main__":
    main()
