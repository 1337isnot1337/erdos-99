#!/usr/bin/env python3
"""Exact linear-algebra certificate for the pentagon turn-hull theorem.

The analytic part of the theorem proves q_i>1/3 for physical pentagons and
constructs strict physical families approaching the five boundary vertices.
This script checks, over Q, that the q-transform is unimodular, that its inverse
has the stated cyclic form, and that q_i>=1/3 with sum q_i=2 is exactly the
4-simplex with the five stated turn-vector vertices. It also verifies all
previous one-turn/two-turn non-strict bounds on those vertices.
"""

from fractions import Fraction as F
from itertools import product

N = 5

# q_i = x_i + x_{i+1} - x_{i+3}.
M = [[F(0) for _ in range(N)] for _ in range(N)]
for i in range(N):
    M[i][i] += 1
    M[i][(i + 1) % N] += 1
    M[i][(i + 3) % N] -= 1


def det(A):
    A = [row[:] for row in A]
    out = F(1)
    for c in range(len(A)):
        pivot = next(i for i in range(c, len(A)) if A[i][c])
        if pivot != c:
            A[c], A[pivot] = A[pivot], A[c]
            out *= -1
        p = A[c][c]
        out *= p
        A[c] = [z / p for z in A[c]]
        for i in range(c + 1, len(A)):
            q = A[i][c]
            if q:
                A[i] = [a - q * b for a, b in zip(A[i], A[c])]
    return out


assert det(M) == 1

# Claimed inverse: x_i=q_{i+1}-q_{i+2}+q_{i+3}.
Minv = [[F(0) for _ in range(N)] for _ in range(N)]
for i in range(N):
    Minv[i][(i + 1) % N] += 1
    Minv[i][(i + 2) % N] -= 1
    Minv[i][(i + 3) % N] += 1

for i, j in product(range(N), repeat=2):
    value = sum(M[i][k] * Minv[k][j] for k in range(N))
    assert value == (1 if i == j else 0)

# Sum q_i = sum x_i.
assert [sum(M[i][j] for i in range(N)) for j in range(N)] == [F(1)] * N

# q-simplex vertices: one coordinate 2/3, the other four 1/3.
vertices = []
for hot in range(N):
    q = [F(1, 3)] * N
    q[hot] = F(2, 3)
    x = [sum(Minv[i][j] * q[j] for j in range(N)) for i in range(N)]
    vertices.append(tuple(x))

expected = {
    (F(1, 3), F(1, 3), F(2, 3), F(0), F(2, 3)),
    (F(2, 3), F(1, 3), F(1, 3), F(2, 3), F(0)),
    (F(0), F(2, 3), F(1, 3), F(1, 3), F(2, 3)),
    (F(2, 3), F(0), F(2, 3), F(1, 3), F(1, 3)),
    (F(1, 3), F(2, 3), F(0), F(2, 3), F(1, 3)),
}
assert set(vertices) == expected

# Every vertex obeys the closed forms of the old bounds. Since every point of
# the q-polytope is a convex combination of these vertices, the old closed
# one-turn/two-turn bounds follow throughout the simplex.
for x in vertices:
    assert sum(x) == 2
    for i in range(N):
        assert F(0) <= x[i] <= F(2, 3)
        p = x[i] + x[(i + 1) % N]
        assert F(2, 3) <= p <= F(1)
        q = x[i] + x[(i + 1) % N] - x[(i + 3) % N]
        assert q >= F(1, 3)

print("PASS: det(q<-x)=1 and the cyclic inverse is exact")
print("PASS: q_i>=1/3, sum q=2 is a 4-simplex with five exact vertices")
print("PASS: all old closed one-turn/two-turn bounds hold on every simplex vertex")
