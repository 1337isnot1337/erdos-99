"""Regression tests for the exact mixed-monomer interface certificate."""

import unittest
from fractions import Fraction

from mixed_monomer_interface import (
    diagonal_interface_certificate,
    diagonal_interface_is_unit_separated,
    diagonal_interface_matching_is_injective,
    mixed_blocker_pair,
    mixed_blocker_separation_squared,
    mixed_monomer_certificate,
    minus_triangle,
    monomer_vertex_maximum_squared,
    plus_triangle,
    subhalf_anchor_hall_bound,
)


class MixedMonomerInterfaceTests(unittest.TestCase):
    def test_rational_pair_is_inside_adjacent_opposite_cells(self) -> None:
        certificate = mixed_monomer_certificate(Fraction(1, 10))
        self.assertTrue(certificate["plus_is_strictly_inside"])
        self.assertTrue(certificate["minus_is_strictly_inside"])
        self.assertEqual(certificate["own_vertex_maximum_squared"], Fraction(73, 100))
        self.assertEqual(certificate["blocker_separation_squared"], Fraction(48, 25))
        self.assertTrue(certificate["blockers_unit_separated"])

    def test_complete_conflict_neighborhoods_are_the_declared_triangles(self) -> None:
        plus_blocker, minus_blocker = mixed_blocker_pair(Fraction(1, 10))
        certificate = mixed_monomer_certificate(Fraction(1, 10))
        self.assertEqual(
            certificate["plus_neighborhood"],
            frozenset({(0, 0), (1, 0), (0, 1)}),
        )
        self.assertEqual(
            certificate["minus_neighborhood"],
            frozenset({(1, 0), (0, 1), (1, 1)}),
        )
        self.assertTrue(all(
            sum(
                (
                    (plus_blocker[0] - vertex[0]) ** 2,
                    (plus_blocker[0] - vertex[0])
                    * (plus_blocker[1] - vertex[1]),
                    (plus_blocker[1] - vertex[1]) ** 2,
                )
            ) < 1
            for vertex in plus_triangle()
        ))
        self.assertEqual(len(minus_triangle()), 3)

    def test_entire_rational_parameter_subfamily_remains_compatible(self) -> None:
        for parameter in (Fraction(1, 20), Fraction(1, 10), Fraction(1, 5)):
            self.assertLess(monomer_vertex_maximum_squared(parameter), 1)
            self.assertGreater(mixed_blocker_separation_squared(parameter), 1)

    def test_the_chosen_corner_well_has_a_finite_separation_threshold(self) -> None:
        self.assertEqual(mixed_blocker_separation_squared(Fraction(1, 4)), Fraction(3, 4))
        self.assertLess(mixed_blocker_separation_squared(Fraction(1, 4)), 1)

    def test_parameter_endpoints_are_rejected(self) -> None:
        with self.assertRaises(ValueError):
            mixed_blocker_pair(Fraction(0))
        with self.assertRaises(ValueError):
            mixed_blocker_pair(Fraction(1, 2))

    def test_arbitrarily_long_diagonal_interface_has_exact_local_certificates(self) -> None:
        for side in (1, 2, 5, 11):
            certificate = diagonal_interface_certificate(side, Fraction(1, 10))
            self.assertEqual(certificate["blocker_count"], side * (side + 1))
            self.assertEqual(
                certificate["expected_blocker_count"], side * (side + 1)
            )
            self.assertTrue(certificate["unit_separated"])
            self.assertTrue(certificate["complete_neighborhoods"])
            self.assertTrue(certificate["matching_saturates_cells"])
            self.assertEqual(certificate["raw_incidence_deficiency"], -(side + 1))
            self.assertEqual(
                certificate["subhalf_anchor_bound"]["central_count"], 0
            )
            self.assertEqual(
                certificate["subhalf_anchor_bound"]["hall_deficiency_upper_bound"],
                0,
            )
            self.assertEqual(
                len(set().union(*certificate["neighborhoods"])),
                (side + 1) ** 2,
            )

    def test_diagonal_interface_separation_is_exactly_quadratic(self) -> None:
        self.assertTrue(diagonal_interface_is_unit_separated(17, Fraction(1, 5)))
        self.assertFalse(diagonal_interface_is_unit_separated(2, Fraction(1, 4)))

    def test_explicit_matching_is_injective_for_the_whole_interface(self) -> None:
        self.assertTrue(diagonal_interface_matching_is_injective(23, Fraction(1, 10)))

    def test_subhalf_anchor_bound_is_a_hall_deficiency_upper_bound(self) -> None:
        point = (Fraction(1, 3), Fraction(1, 3))
        neighborhood = frozenset({(0, 0), (1, 0), (0, 1)})
        bound = subhalf_anchor_hall_bound(((point, neighborhood),))
        self.assertEqual(bound["central_count"], 1)
        self.assertEqual(bound["hall_deficiency_upper_bound"], 1)


if __name__ == "__main__":
    unittest.main()
