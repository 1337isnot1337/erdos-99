from fractions import Fraction
from math import sqrt

s0 = Fraction(791, 320_000_000)
gamma = s0 / 30
lower_density = gamma / 4
oriented_density = gamma / 8
good_density = gamma / 16
pure_density = Fraction(1609, 2500)  # 0.6436
Tstar = Fraction(6121, 2000)        # 3.0605
thread_density = good_density * pure_density / Tstar

assert lower_density == Fraction(791, 38_400_000_000)
assert oriented_density == Fraction(791, 76_800_000_000)
assert good_density == Fraction(791, 153_600_000_000)
assert thread_density == Fraction(1_272_719, 1_175_232_000_000_000)
assert 1.0829e-9 < float(thread_density) < 1.0830e-9

# Fifteen-spaced owners plus support length <=14 imply that after fixing
# left/right orientation the exact selected-cut intervals are disjoint.
for direction in (-1, 1):
    for i in range(0, 100, 15):
        first = []
        for gap in range(1, 15):
            j = i + direction * gap
            a, b = sorted((i, j))
            first.append(set(range(a + 1, b + 1)))

        ip = i + 15
        for gap in range(1, 15):
            jp = ip + direction * gap
            ap, bp = sorted((ip, jp))
            second = set(range(ap + 1, bp + 1))
            for interval in first:
                assert interval.isdisjoint(second)

# Local circumcenter flank density after deleting sigma=.01 of the columns.
flank_density = 0.6436 - 1.02 / sqrt(3)
assert 0.05470 < flank_density < 0.05471

print("PASS: permanent-lower local-ladder synchronization regressions")
print("lower_density=", float(lower_density))
print("oriented_density=", float(oriented_density))
print("good_density=", float(good_density))
print("single_thread_density=", float(thread_density))
print("flank_density=", flank_density)
