#!/usr/bin/env python3
"""Arithmetic/logic checks for seven-no-root D=-1,k=6,d=0,p=10 reduction.

This script encodes only finite integer consequences. The non-arithmetic inputs
(the six-row singleton-capacity/support census and five-row sharp-boundary
classification) are established by earlier committed exact verifiers.
"""
from math import ceil


def qmin(pi: int, di: int) -> int:
    # six-row containment at D6=1:
    # 1 >= 6 + pi + 3*di - 3*qi
    return ceil((5 + pi + 3 * di) / 3)


def min_singletons(pi: int, qi: int) -> int:
    # qi nonempty incomplete blocks occupying pi selected rows:
    # pairs cost 2, singletons cost 1.
    return max(0, 2 * qi - pi)


def main() -> None:
    # A good deletion has pi in {1,4,7,10}, deficiency at least two.
    # pi=1,4 are impossible even at qi=pi and di=2.
    assert 6 + 1 + 3 * 2 - 3 * 1 > 1
    assert 6 + 4 + 3 * 2 - 3 * 4 > 1

    # pi=7: d=2 would require q>=6, hence at least five singleton blocks,
    # contradicting the exact d=2 singleton-capacity maximum three.
    assert qmin(7, 2) == 6
    assert min_singletons(7, 6) == 5 > 3
    # d=3 forces q=7 exactly; d>=4 is impossible since q would exceed p.
    assert qmin(7, 3) == 7
    assert qmin(7, 4) == 8 > 7

    # pi=10: d=2 again contradicts capacity three. d=3 requires q>=8;
    # d=4 requires q>=9.
    assert qmin(10, 2) == 7
    assert min_singletons(10, 7) == 4 > 3
    assert qmin(10, 3) == 8
    assert qmin(10, 4) == 9

    # Every non-p10 deletion loses at least three selected rows. Total deletion
    # loss is at most the global p=10, so at most three of seven deletions are
    # non-p10, i.e. at least four are p10.
    global_p = 10
    max_non_p10 = global_p // 3
    min_p10 = 7 - max_non_p10
    assert max_non_p10 == 3
    assert min_p10 == 4

    # For global virtual pattern (dv,q)=(3,10), every p10 good shadow has
    # d=3 and singleton capacity >=8. The exact six-row census says such a
    # shadow has coefficient-line support at most three. Hence global support
    # >=5 is impossible after any deletion, and support=4/3 are eliminated by
    # the incidence arguments below, leaving support exactly two.
    global_singletons = 10
    q_per_p10 = 8

    # support=4: all four support-coordinate deletions must be p10. Each needs
    # >=8 relevant blocks. The exact support-three audit makes every counted
    # block have a two-element global touch set inside the four support coords,
    # so each block can be counted by at most two support-coordinate deletions.
    assert 4 * q_per_p10 > 2 * global_singletons

    # support=3: among four zero-coordinate deletions, exactly one must be p10
    # and three p7. The three p7 deletions lose 3 disjoint singleton blocks
    # each; the p10 zero deletion needs >=8 blocks with a different two-touch
    # pattern. These sets are disjoint.
    assert 3 * 3 + q_per_p10 > global_singletons

    # support=2: deleting the two support coordinates kills the rank-one line,
    # giving a five-row k=5,D=0 shadow. The established sharp-boundary table
    # says a five-row k=5,D=0 state has p=10. Since the global (3,10) pattern
    # consists of ten singleton incomplete blocks using all ten rows, all ten
    # survive and remain singletons in that five-row shadow.
    pair_shadow_p = 10
    assert pair_shadow_p == global_p

    print("PASS: seven-no-root D=-1,k=6,d=0,p=10 structural reduction arithmetic")
    print("good_p7", {"d": 3, "q": 7, "singleton_capacity": 7})
    print("good_p10_qmin", {3: qmin(10, 3), 4: qmin(10, 4)})
    print("minimum_p10_deletions", min_p10)
    print("dv3_q10_support_remaining", 2)
    print("support4_incidence", (4 * q_per_p10, 2 * global_singletons))
    print("support3_disjoint_requirement", 3 * 3 + q_per_p10)
    print("support2_pair_shadow", {"k": 5, "D": 0, "p": pair_shadow_p, "singletons": 10})


if __name__ == "__main__":
    main()
