#!/usr/bin/env python3
"""Regression checks for the one-row LOWER face-wedge formulas.

The theorem itself is symbolic.  These deterministic checks guard the sign choices and
closed-boundary cases in the exact trigonometric identities used by the proof.
"""
import math
import random

rng = random.Random(20260917)

for _ in range(20000):
    # The proof only needs epsilon < pi/6.  Sample several orders of magnitude.
    log_eps = rng.uniform(math.log(1e-8), math.log(0.49))
    eps = math.exp(log_eps)
    delta = rng.random() * eps
    if delta == 0.0:
        delta = eps / 2

    phi = 2 * math.pi / 3 - delta       # transverse side c
    b_arg = math.pi - eps               # opposite rooted boundary vector b

    # Initial blocker diagonal r=a+c, with arg(a)=0.
    initial2 = 2 + 2 * math.cos(phi)
    assert initial2 > 1.0

    # Exact swap sends r to c-b.
    post_angle = b_arg - phi
    post2 = 2 - 2 * math.cos(post_angle)
    assert post_angle <= math.pi / 3 + 1e-12
    assert post2 <= 1.0 + 1e-12

    # Strict support-face crossing defect is delta above pi/3.
    row_gap = math.pi - phi
    assert abs(row_gap - (math.pi / 3 + delta)) < 1e-12
    assert row_gap > math.pi / 3

    # Opposite row has projective phase -epsilon.  Its projective gap from c
    # is pi/3 + delta - epsilon <= pi/3, so strict train crossing is impossible.
    opposite_gap = math.pi - (phi + eps)
    assert abs(opposite_gap - (math.pi / 3 + delta - eps)) < 1e-12
    assert opposite_gap <= math.pi / 3 + 1e-12

# Boundary delta=epsilon gives post-swap length exactly one and opposite-row gap pi/3.
for eps in (1e-6, 1e-3, 0.1, 0.49):
    delta = eps
    phi = 2 * math.pi / 3 - delta
    post_angle = (math.pi - eps) - phi
    assert abs(post_angle - math.pi / 3) < 1e-12
    assert abs((2 - 2 * math.cos(post_angle)) - 1.0) < 1e-12
    assert abs((math.pi - (phi + eps)) - math.pi / 3) < 1e-12

print("one-row LOWER face-wedge regression: PASS")
