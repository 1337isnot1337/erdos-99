#!/usr/bin/env python3
"""Regression certificate for Target C Section 111 joint-shore gap."""

import math

PI = math.pi
THETA8 = 2.7029080296483676832
MU8 = 0.9760407652670519821
SIGMA = 4.0e-4
R = 0.472
CT = 1.83
SHORE = 0.08
E0 = 0.16
H = 0.0262
RHO = 0.039


def slack(theta: float) -> float:
    return 3.0 * theta - 2.0 * PI - math.sin(theta / 2.0) - 2.0 * math.sin(theta)


def root(target: float) -> float:
    lo, hi = THETA8, THETA8 + 0.01
    for _ in range(200):
        mid = (lo + hi) / 2.0
        if slack(mid) < target:
            lo = mid
        else:
            hi = mid
    return (lo + hi) / 2.0


def main() -> None:
    theta = root(SIGMA)
    mu = math.sin(theta / 2.0)
    U = 3.0 * theta - 2.0 * PI

    assert abs(theta - 2.7029931020938935) < 5e-15
    assert abs(mu - 0.9760500197446322) < 5e-15
    assert 9.24e-6 < mu - MU8 < 9.27e-6
    assert abs(slack(theta) - SIGMA) < 5e-15

    train_bound = U + 2.0 * SIGMA
    assert train_bound < 1.827
    assert train_bound < CT

    joint_shore_limit = R / (3.0 * CT)
    old_limit = R / (6.0 * CT)
    assert joint_shore_limit > 0.08597
    assert SHORE < joint_shore_limit
    assert abs(joint_shore_limit - 2.0 * old_limit) < 1e-15

    # Explicit finite shore regression.
    retained = 0.471
    cphase = 5.317
    K = 5000.0
    m = 100.0
    good = retained - cphase / K
    internal = (1.0 - 1.0 / m) * good / 3.0
    joint_small_capacity = SHORE * CT
    assert internal > 0.15507
    assert abs(joint_small_capacity - 0.1464) < 1e-15
    assert internal - joint_small_capacity > 0.0086

    # Leakage and principal corridor population.
    w = PI / 3.0 - math.acos((1.0 + H) / 2.0)
    leakage = w + (1.0 / H + 169.0 / 6.0) * SIGMA
    remaining = E0 - leakage
    per_corridor = remaining / 3.0
    assert abs(leakage - 0.0417276437063437) < 5e-15
    assert per_corridor > 0.03942
    assert per_corridor > RHO

    mismatch = THETA8 / 2.0 - PI / 3.0 - (73.0 / 6.0) * SIGMA
    delta = math.acos(1.0 - SIGMA / RHO)
    assert 2.0 * delta < PI / 3.0
    assert mismatch > 0.29938
    assert mismatch - 2.0 * delta > 0.01269

    print(f"theta15={theta:.16f}")
    print(f"mu15={mu:.16f}")
    print(f"gain={mu - MU8:.12e}")
    print(f"U={U:.16f}")
    print(f"T/D upper={train_bound:.16f}")
    print(f"old shore limit={old_limit:.16f}")
    print(f"joint shore limit={joint_shore_limit:.16f}")
    print(f"internal-bin density={internal:.16f}")
    print(f"joint small-shore capacity={joint_small_capacity:.16f}")
    print(f"leakage={leakage:.16f}")
    print(f"per-corridor endpoint density={per_corridor:.16f}")
    print(f"Delta={delta:.16f}")
    print(f"corridor mismatch floor={mismatch:.16f}")
    print(f"contradiction margin={mismatch - 2.0 * delta:.16f}")


if __name__ == "__main__":
    main()
