#!/usr/bin/env python3
"""Regression checks for the full tagged high-t nested rail."""

from fractions import Fraction as Q

c0 = Q(113, 20_000_000)
assert float(c0 / Q(2, 1)) == 2.825e-6
assert float(c0 / Q(4, 1)) == 1.4125e-6

endpoint_disjoint = float(c0) / (8 * 3 ** (1 / 8))
one_tag_endpoint_disjoint = float(c0) / (16 * 3 ** (1 / 8))
assert 6.1562e-7 < endpoint_disjoint < 6.1564e-7
assert 3.0780e-7 < one_tag_endpoint_disjoint < 3.0783e-7

rho = c0 / Q(100, 1)
eta = c0 / Q(50, 1)
deep = c0 - 2 * rho - eta
assert deep == Q(24, 25) * c0
assert abs(float(deep) - 5.424e-6) < 1e-18
assert abs(float(deep / 2) - 2.712e-6) < 1e-18

deep_endpoint_disjoint = float(deep) / (4 * 3 ** (1 / 8))
deep_one_destination = deep_endpoint_disjoint / 2
assert 1.1819e-6 < deep_endpoint_disjoint < 1.1821e-6
assert 5.909e-7 < deep_one_destination < 5.911e-7

# Increasing birth tags plus nonincreasing death tags force strict nesting.
for M in range(1, 40):
    births = list(range(1, M + 1))
    deaths = list(range(3 * M, 2 * M, -1))
    intervals = [set(range(i + 1, b + 1)) for i, b in zip(births, deaths)]
    for j in range(M - 1):
        assert intervals[j + 1] < intervals[j]

print("PASS: host-tagged full nested rail regressions")
print("full rail density =", float(c0 / 2))
print("one-tag density =", float(c0 / 4))
print("full endpoint-disjoint coeff =", endpoint_disjoint)
print("deep rail density =", float(deep))
print("deep one-destination density =", float(deep / 2))
print("deep endpoint-disjoint coeff =", deep_endpoint_disjoint)
