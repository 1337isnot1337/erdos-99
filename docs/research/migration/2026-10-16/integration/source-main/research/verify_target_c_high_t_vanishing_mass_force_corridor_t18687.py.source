#!/usr/bin/env python3
"""Regression checks for the vanishing-mass fully loaded force corridor."""

import itertools
import math
from fractions import Fraction as Q

c = Q(113, 5_000_000)

# The concrete diagonal inherited from the near-full-shore force theorem.
for n in [1, 2, 5, 10, 100, 1000]:
    r = n
    m = 2 * r + 1
    lam = c / 2 - 3 * c / (40 * n)
    rho = c / (80 * n * m)

    assert lam > 0
    assert lam == c * Q(20 * n - 3, 40 * n)
    assert rho > 0

    # An admissible diagonal can always choose D this large (and larger).
    # This explicit scale makes D^(1/4)*rho = 2n, hence tends to infinity.
    D = (2.0 * n / float(rho)) ** 4
    assert abs(D ** 0.25 * float(rho) - 2.0 * n) / (2.0 * n) < 1e-12

    # If Q has density lam, residue-class packing gives at least |Q|/m
    # disjoint radius-r blocks, so one block has switching mass <= m/|Q|.
    mass_upper = m / (float(lam) * D)
    assert mass_upper > 0
    assert mass_upper < 1.0 / n

    # The exact two-ray compression satisfies sum(lambda^-+lambda^+)
    # <= 2 sum(B_i)/sin(rho).  This also vanishes on the same diagonal.
    coeff_upper = 2.0 * mass_upper / math.sin(float(rho))
    assert coeff_upper < 1.0 / n

# Asymptotic leading coefficient for the switching-mass estimate:
# (2r+1)/((c/2)D) ~ (4/c) r/D.
leading = Q(4, 1) / c
assert leading == Q(20_000_000, 113)
assert 176_991.15 < float(leading) < 176_991.16

# Exhaustively verify the residue-class packing combinatorics on small sets.
# Centers in one residue class modulo m have disjoint radius-r interface blocks.
for r in range(1, 4):
    m = 2 * r + 1
    universe = list(range(0, 9))
    for mask in range(1, 1 << len(universe)):
        centers = [universe[j] for j in range(len(universe)) if mask & (1 << j)]
        classes = [[x for x in centers if x % m == a] for a in range(m)]
        best = max(classes, key=len)
        assert len(best) * m >= len(centers)

        blocks = [(x - r, x + r) for x in sorted(best)]
        for (_, right), (left2, _) in zip(blocks, blocks[1:]):
            assert right < left2

# Pigeonhole mass statement itself: if nonnegative disjoint block masses sum <= 1,
# some block has mass <= 1/M.
for M in range(1, 20):
    equal = [1.0 / M] * M
    assert min(equal) <= 1.0 / M + 1e-15
    skew = [1.0 / (2 * M)] * (M - 1)
    skew.append(1.0 - sum(skew))
    assert sum(skew) <= 1.0 + 1e-15
    assert min(skew) <= 1.0 / M + 1e-15

print("PASS: vanishing-mass fully loaded force corridor regressions")
print("c/2 =", float(c / 2))
print("leading switching-mass coefficient 4/c =", float(leading))

# Any length-m word with b bad interfaces has a good consecutive run of length
# at least (m-b)/(b+1).  Exhaustively verify the integer form
# L*(b+1) >= m-b for small words.
for m in range(1, 13):
    for bits in itertools.product([0, 1], repeat=m):  # 1 = bad
        b = sum(bits)
        longest = 0
        cur = 0
        for bit in bits:
            if bit:
                cur = 0
            else:
                cur += 1
                longest = max(longest, cur)
        assert longest * (b + 1) >= m - b

print("PASS: good-subcorridor run-length regressions")
