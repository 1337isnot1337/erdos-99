#!/usr/bin/env python3
"""Arithmetic checker for the seven-no-root deletion-shadow reduction.

The companion note proves the matroid and block-linear-algebra statements. This
script checks only their finite arithmetic consequences:

* a negative seven-no-root defect is D in {-2,-1};
* if k is the seven-row quotient nullity and d=c-delta(R), then
      D = 7 + p + 3*d - 3*k;
* every one-row deletion has (D1,k1)=(D+2,k-1);
* for D=-2, every two-row deletion has (D2,k2)=(2,k-2);
* for D=-1, every two-row deletion has either (D2,k2)=(3,k-2)
  or (0,k-1), according as the second quotient-rank drop is 0 or 1.

It also lists the exact (D,k,d,p) boundary tuples requiring any seven-row
finite audit.
"""

EXPECTED = {
    # D=-2: p+3d=3k-9.
    (-2, 3, 0, 0),
    (-2, 4, 0, 3), (-2, 4, 1, 0),
    (-2, 5, 0, 6), (-2, 5, 1, 3), (-2, 5, 2, 0),
    (-2, 6, 0, 9), (-2, 6, 1, 6), (-2, 6, 2, 3), (-2, 6, 3, 0),
    (-2, 7, 0, 12), (-2, 7, 1, 9), (-2, 7, 2, 6),
    (-2, 7, 3, 3), (-2, 7, 4, 0),
    # D=-1: p+3d=3k-8.
    (-1, 3, 0, 1),
    (-1, 4, 0, 4), (-1, 4, 1, 1),
    (-1, 5, 0, 7), (-1, 5, 1, 4), (-1, 5, 2, 1),
    (-1, 6, 0, 10), (-1, 6, 1, 7), (-1, 6, 2, 4), (-1, 6, 3, 1),
    (-1, 7, 0, 13), (-1, 7, 1, 10), (-1, 7, 2, 7),
    (-1, 7, 3, 4), (-1, 7, 4, 1),
}


def boundary_cases():
    out = set()
    for defect in (-2, -1):
        for k in range(8):
            for d in range(16):
                for p in range(64):
                    if 7 + p + 3 * d - 3 * k == defect:
                        out.add((defect, k, d, p))
    return out


def one_deletion(defect, k):
    return defect + 2, k - 1


def two_deletion_options(defect, k):
    if defect == -2:
        # Five-row nonnegativity forces the second quotient-rank drop to be 0.
        return {(2, k - 2)}
    assert defect == -1
    # qdrop=0 gives m=1 and D2=3; qdrop=1 gives m=0 and D2=0.
    return {(3, k - 2), (0, k - 1)}


def main():
    got = boundary_cases()
    assert got == EXPECTED, (got ^ EXPECTED)
    assert len(got) == 30
    assert all(k >= 3 for _defect, k, _d, _p in got)

    for defect, k, d, p in sorted(got):
        d1, k1 = one_deletion(defect, k)
        assert d1 in (0, 1)
        assert k1 == k - 1
        assert 6 + p + 3 * d - 3 * k1 == d1

        options = two_deletion_options(defect, k)
        if defect == -2:
            assert options == {(2, k - 2)}
        else:
            assert options == {(3, k - 2), (0, k - 1)}
        for d2, k2 in options:
            assert 5 + p + 3 * d - 3 * k2 == d2
            assert d2 >= 0

    print("PASS: seven-no-root deletion-shadow arithmetic")
    print("boundary_case_count", len(got))
    print("defect k d p deletion_defect deletion_k pair_options")
    for defect, k, d, p in sorted(got):
        print(
            defect, k, d, p,
            defect + 2, k - 1,
            sorted(two_deletion_options(defect, k)),
        )


if __name__ == "__main__":
    main()
