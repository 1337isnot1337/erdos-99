#!/usr/bin/env python3
"""Exact support certificate closing the final eight-no-root k=3 branch.

A hypothetical eight-no-root counterexample with k=3 is forced arithmetically to
D=-1, d_root=0, p=0.  Its rank-five coefficient-constraint space has
generalized weights at least (2,4,5,7,8).  Because p=0, every touched
incomplete root block is actual-empty and the empty-block local spaces generate
P.  This verifier searches a relaxation of those possible empty-block families.
"""
from collections import Counter
from pathlib import Path
import sys

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import verify_target_c_support7_global_segment_relative_eight_noroot_k4_dminus1_d1p0_support_closure_2026_09_26 as B


def search_empty_sets(ms, data, census):
    h = len(data)

    # d_root=0 makes the touched complete rows independent, hence there are at
    # most 15 of them.  If e is the number of touched actual-empty blocks, then
    # e>=h-15.  Every empty block has at least two incidences (d1(P)>=2), while
    # every other touched block has at least one.  The eight no-root cycles give
    # exactly 32 incidences, so 32>=h+e>=2h-15 and h<=23.
    if h > 23:
        return
    census["touch_at_most_23"] += 1

    eligible = sorted(b for b in data if B.individually_eligible(data[b]))
    later = {
        b: {w for w in eligible if w > b and B.compatible(data[b], data[w])}
        for b in eligible
    }
    min_empty = max(0, h - 15)
    T = tuple(sorted(data))
    rank_T = B.tri_rank(T)

    def test(E, dim_sum):
        if len(E) < min_empty:
            return
        census["cardinality_compatible_empty_sets"] += 1

        # Empty local spaces generate rank(P)=5.
        if dim_sum < 5:
            return
        census["dimension_at_least_5"] += 1

        # d5(P)=8: the global rank-five space has all eight coordinates in its
        # support.  Actual local supports are contained in these occurrence sets,
        # so their occurrence union must already cover all eight coordinates.
        if B.occurrence_union_size(E, data) < 8:
            return
        census["full_support_empty_sets"] += 1

        Eset = set(E)
        C = tuple(b for b in T if b not in Eset)
        rank_C = B.tri_rank(C)

        # d_root=0: every touched complete-row subset is independent.
        if rank_C != len(C):
            return
        census["complete_independent"] += 1

        # k=3 gives three independent external relation directions.  The
        # committed face-local identity puts their lifts in H(T).  Modulo the
        # touched complete span this requires at least three dimensions.
        capacity = rank_T - rank_C
        census[f"capacity_{capacity}"] += 1
        if capacity >= 3:
            census["capacity_survivors"] += 1

    def rec(E, candidates, dim_sum):
        if len(E) + len(candidates) < min_empty:
            return
        if dim_sum + sum(data[b][1] for b in candidates) < 5:
            return

        test(E, dim_sum)
        ordered = sorted(candidates)
        for i, b in enumerate(ordered):
            rec(
                E + [b],
                set(ordered[i + 1 :]) & later[b],
                dim_sum + data[b][1],
            )

    rec([], set(eligible), 0)


def main():
    assert B.lucas_lehmer_31()
    assert B.MOD * B.MOD > 3**15

    reps = B.support_multiset_orbits()
    census = Counter()
    census["support_multiset_orbits_size_8"] = len(reps)

    for ms in reps:
        search_empty_sets(ms, B.block_data(ms), census)

    expected = {
        "support_multiset_orbits_size_8": 27763,
        "touch_at_most_23": 24720,
        "cardinality_compatible_empty_sets": 22686,
        "dimension_at_least_5": 16385,
        "full_support_empty_sets": 7203,
        "complete_independent": 59,
        "capacity_0": 38,
        "capacity_1": 19,
        "capacity_2": 2,
        "capacity_survivors": 0,
    }
    for key, value in expected.items():
        assert census[key] == value, (key, census[key], value)

    print("PASS: final eight-no-root k=3 branch closed")
    print("orbit_counts_size_0_through_8", B.EXPECTED_ORBIT_COUNTS)
    for key in expected:
        print(key, census[key])
    print("hadamard_exact_rank_bound", B.MOD * B.MOD > 3**15)


if __name__ == "__main__":
    main()
