#!/usr/bin/env python3
"""Regression checks for the close-pair common-run geometry/cycle minimax."""

from __future__ import annotations

import math


def check_abstract_minimax() -> None:
    for q in (1e4, 1e8, 1e12):
        for a in (1e-3, 1e-2, 0.1, 1.0):
            if q * a < 10.0:
                continue
            s = math.sqrt(q / a)
            trunk = a * s - a
            cycle = q / s - 1.0
            target = math.sqrt(a * q)
            assert trunk >= target - a - 1e-9
            assert cycle >= target - 1.0 - 1e-9


def check_tuned_scales() -> None:
    # R = D^(1/4)/sqrt(Z+1). At the tuned scale:
    # m~R^(1/2), q~R^(3/2), gamma~R^(-1/2), theta_upper~R^(-1/4).
    for r in (1e8, 1e12, 1e16):
        m = r**0.5
        q = r**1.5
        gamma = r**-0.5
        theta_upper = r**-0.25

        same_scale = math.sqrt(q * gamma)
        opposite_scale = math.sqrt(q)

        assert math.isclose(m, r**0.5, rel_tol=1e-12)
        assert math.isclose(same_scale, r**0.5, rel_tol=1e-12)
        assert math.isclose(opposite_scale, r**0.75, rel_tol=1e-12)
        assert theta_upper < 0.02


def check_opposite_stretch() -> None:
    for r in (1e8, 1e12, 1e16):
        theta = r**-0.25
        stretch = 1.0 / math.cos(theta / 2.0)
        assert stretch - 1.0 < r**-0.5


def main() -> None:
    check_abstract_minimax()
    check_tuned_scales()
    check_opposite_stretch()
    print("PASS: close-pair common-run geometry/cycle minimax certificate")


if __name__ == "__main__":
    main()
