#!/usr/bin/env python3
"""Regression certificate for the shallow-tooth reflection-blocker reduction.

The proof is in target_c_shallow_tooth_reflection_blockers_2026-09-14.md. This file
checks the exact constants, reflection identity, angular witness-reuse bound, blocker
inequalities, and sampled finite geometry used there.
"""

from math import acos, cos, floor, pi, sin, sqrt

ETA = 1 / 19
N2 = 0.4363893718701161781
DOUT = 0.002883975

c = 37 / 38
h = 5 * sqrt(3) / 38
alpha = acos(c)
y_minus = sin(pi / 3 - alpha)
y_plus = sin(pi / 3 + alpha)
R = 1 + 2 * h
C = max(R / 2, 1 - 1 / (2 * R * R))
theta = acos(C)
nsh = N2 - DOUT / ETA
balanced = nsh / 9

assert alpha < pi / 12
assert abs(c * c + h * h - 1) < 1e-14
assert abs(y_minus - 8 * sqrt(3) / 19) < 1e-14
assert abs(y_plus - 21 * sqrt(3) / 38) < 1e-14
assert theta > 2 * pi / 9
assert floor(2 * pi / theta) == 8
assert abs(nsh - 0.3815938468701161781) < 2e-15
assert abs(balanced - 0.0423993163189018) < 2e-15

# RB.5: exact reflection identity.
for p in [-4, -1.3, 0, 0.7, 3.1]:
    for q in [-2, -0.2, 0, 0.4, 5]:
        old = p * p + (q - h) ** 2
        new = p * p + (q + h) ** 2
        assert abs((new - old) - 4 * h * q) < 1e-12

# RB.26: sampled annular radii obey the proved corner maximum for f(r,s).
for i in range(101):
    r = 1 + (R - 1) * i / 100
    for j in range(101):
        s = 1 + (R - 1) * j / 100
        f = (r * r + s * s - 1) / (2 * r * s)
        assert f <= C + 1e-12

# RB.11: sampled lower blockers obey the proved depth floor. This is a
# regression check only; the report contains the analytic proof.
for frac in [0.2, 0.5, 0.8, 1.0]:
    a = alpha * frac
    cc, hh = cos(a), sin(a)
    floor_r = sin(pi / 3 - a)
    found = 0
    for ir in range(1, 1000):
        r = ir / 1000
        for iu in range(0, 1201):
            u = iu / 1000
            new = u * u + (r - hh) ** 2
            old = u * u + (r + hh) ** 2
            da = (u + cc) ** 2 + r * r
            db = (u - cc) ** 2 + r * r
            if (
                new < 1 - 1e-7
                and old > 1 + 1e-7
                and da > 1 + 1e-7
                and db > 1 + 1e-7
            ):
                found += 1
                assert r > floor_r - 0.0015
    assert found > 0

# RB.17: sampled exact new contacts lie below the stronger Y_+ depth floor.
for frac in [0.2, 0.5, 1.0]:
    a = alpha * frac
    cc, hh = cos(a), sin(a)
    depth = sin(pi / 3 + a)
    found = 0
    for k in range(36000):
        theta_k = 2 * pi * k / 36000
        u = cos(theta_k)
        yy = -hh + sin(theta_k)
        r = -yy
        if r <= 0:
            continue
        zx = u * u + (yy - hh) ** 2
        za = (u + cc) ** 2 + yy * yy
        zb = (u - cc) ** 2 + yy * yy
        if zx > 1 + 1e-8 and za > 1 + 1e-8 and zb > 1 + 1e-8:
            found += 1
            assert r > depth - 2e-4
    assert found > 0

# RB.20-RB.22: sampled upper blockers satisfy the exact normal-cone inequality
# and the D-2h near-diameter conclusion.
upper_hits = 0
for diameter in [5.0, 10.0, 30.0]:
    for ip in range(-100, 101):
        p = ip * diameter / 500
        for iq in range(1, 501):
            q = iq * diameter / 500
            reflected = p * p + (q + h) ** 2
            da = (p + c) ** 2 + q * q
            db = (p - c) ** 2 + q * q
            if (
                reflected > diameter * diameter + 1e-9
                and da <= diameter * diameter + 1e-9
                and db <= diameter * diameter + 1e-9
            ):
                upper_hits += 1
                assert 2 * h * q - 2 * c * abs(p) > c * c - h * h - 1e-9
                assert abs(p) / q < h / c + 1e-9
                old_xy = sqrt(p * p + (q - h) ** 2)
                assert old_xy > diameter - 2 * h - 1e-9

assert upper_hits > 0

print(f"eta={ETA}")
print(f"alpha={alpha:.15f}")
print(f"2h={2*h:.15f}")
print(f"Y_minus={y_minus:.15f}")
print(f"Y_plus={y_plus:.15f}")
print(f"R={R:.15f}, C={C:.15f}, theta={theta:.15f}, reuse<=8")
print(f"N_sh/D >= {nsh:.15f}")
print(f"balanced branch floor = {balanced:.15f}")
print(f"upper-blocker sampled tuples={upper_hits}")
print("PASS: sharpened reflection-blocker certificate")
