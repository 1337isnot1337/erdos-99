#!/usr/bin/env python3
"""Arithmetic certificate for high-t residual/near-contact matching densities."""
from fractions import Fraction as Q
from math import isqrt


def atan_inv_bounds(q, n):
    s = Q(0)
    for k in range(n):
        term = Q(1, (2*k+1)*q**(2*k+1))
        s += term if k % 2 == 0 else -term
    nxt = Q(1, (2*n+1)*q**(2*n+1))
    return (s, s+nxt) if n % 2 == 0 else (s-nxt, s)


def sqrt_bounds(lo, hi, scale):
    a = isqrt((lo.numerator*scale*scale)//lo.denominator)
    b = isqrt((hi.numerator*scale*scale)//hi.denominator)
    return Q(a, scale), Q(b+1, scale)


a5l, a5h = atan_inv_bounds(5, 90)
a239l, a239h = atan_inv_bounds(239, 25)
pil, pih = 16*a5l-4*a239h, 16*a5h-4*a239l
SCALE = 10**90
n3 = isqrt(3*SCALE*SCALE)
s3l, s3h = Q(n3, SCALE), Q(n3+1, SCALE)
Dl, Dh = pil/(2*s3h), pih/(2*s3l)
sDl, _ = sqrt_bounds(Dl, Dh, SCALE)
C707 = 2*sDl + Q(7707, 1000000)


def p5(T):
    return pil + C707 - Q(5, 2)*T


rows = [
    (Q(47, 25), Q(168, 10000)),
    (Q(19, 10), Q(144, 10000)),
    (Q(48, 25), Q(120, 10000)),
    (Q(49, 25), Q(73, 10000)),
    (Q(2, 1), Q(25, 10000)),
    (Q(201, 100), Q(13, 10000)),
    (Q(101, 50), Q(18, 100000)),
]

for T, claim in rows:
    density = p5(T)/21
    assert density > claim, (T, density, claim)
    print('T =', float(T), 'p5/21 >', float(density), 'claimed', float(claim))

threshold = Q(2, 5)*(C707 + pil)
assert threshold > Q(20215, 10000)
print('pentagon positivity threshold >', float(threshold))
print('PASS high-t residual/near-contact matching arithmetic')
