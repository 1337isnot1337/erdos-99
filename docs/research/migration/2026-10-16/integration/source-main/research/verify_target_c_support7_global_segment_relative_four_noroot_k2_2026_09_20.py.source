#!/usr/bin/env python3
"""Exact t=4, k=2 rank-density barrier for the Target-C four-cycle system.

For four no-root four-cycles, a possible violation of 3*delta(A)<=|A| has
(k,p) in {(2,p<=1),(3,p<=4),(4,p<=7)} after stripping harmless untouched
blocks. This verifier closes the first regime exactly.

The 4,780,230 unordered no-root quadruples are reduced to 1,186 S7 orbits.
For k=2,p<=1, every touched incomplete root-0 block is empty except for at
most one singleton. For a fixed rank-2 external constraint plane and fixed
singleton choice, leaving every compatible block empty gives the least-row
state. Any other state in that class is obtained by completing empty blocks;
each completion adds 3 rows and at most one relative T direction, so
|A|-3*delta cannot decrease. The script therefore exactifies only those
canonical minimal completions.

All coordinate construction is exact over Fraction. Final small T-ranks are
computed modulo P=2^127-1, with a Lucas-Lehmer primality check and an explicit
Hadamard bound on every integer relation row, making each rank decision exact
over Q rather than probabilistic finite-field evidence.
"""
from fractions import Fraction
from itertools import combinations, permutations
from collections import Counter
from math import comb, gcd, lcm
import argparse, functools, time

VERTICES=tuple(range(8))
SEGMENTS=tuple(combinations(VERTICES,2)); SEGMENT_INDEX={e:i for i,e in enumerate(SEGMENTS)}
LINE_EDGES=[]; LINE_EDGE_INDEX={}
for i,j in combinations(range(len(SEGMENTS)),2):
    if set(SEGMENTS[i]) & set(SEGMENTS[j]):
        LINE_EDGE_INDEX[(i,j)]=len(LINE_EDGES); LINE_EDGES.append((i,j))
assert len(SEGMENTS)==28 and len(LINE_EDGES)==168

def seg(a,b): return SEGMENT_INDEX[tuple(sorted((a,b)))]
def line_cycle(ids):
    row=[0]*len(LINE_EDGES); ids=list(ids)
    for x,y in zip(ids,ids[1:]+ids[:1]):
        if x<y: row[LINE_EDGE_INDEX[(x,y)]] += 1
        else: row[LINE_EDGE_INDEX[(y,x)]] -= 1
    return row

def k8_cycle(vs):
    vs=list(vs); return line_cycle([seg(vs[i],vs[(i+1)%len(vs)]) for i in range(len(vs))])
def side_triangle(a,b,c): return line_cycle([seg(a,b),seg(b,c),seg(a,c)])
def star_triangle(r,a,b,c): return line_cycle([seg(r,a),seg(r,b),seg(r,c)])
SIDE=[side_triangle(*t) for t in combinations(VERTICES,3)]
GROUND=[star_triangle(0,1,i,j) for i,j in combinations(range(2,8),2)]
FOUR=[]; DESC=[]; seen=set()
for vertex_set in combinations(VERTICES,4):
    a=min(vertex_set); rest=[x for x in vertex_set if x!=a]
    for perm in permutations(rest):
        if perm[0]>=perm[-1]: continue
        d=(a,)+perm; row=k8_cycle(d); key=min(tuple(row),tuple(-x for x in row))
        if key in seen: continue
        seen.add(key); FOUR.append(row); DESC.append(d)
assert len(SIDE)==56 and len(GROUND)==15 and len(FOUR)==210

class RationalBasis:
    def __init__(self,rows=()):
        self.rows={}
        for row in rows:self.add(row)
    def reduce(self,row):
        r=[Fraction(x) for x in row]
        for p in sorted(self.rows):
            if r[p]:
                q=r[p];b=self.rows[p];r=[x-q*y for x,y in zip(r,b)]
        return r
    def add(self,row):
        r=self.reduce(row);p=next((i for i,x in enumerate(r) if x),None)
        if p is None:return False
        q=r[p];self.rows[p]=[x/q for x in r];return True
    @property
    def rank(self):return len(self.rows)
class RationalCoordinateBasis:
    def __init__(self,vectors):
        self.rows={};self.dimension=len(vectors)
        for idx,row in enumerate(vectors):
            r=list(row);coeff=[Fraction(0)]*self.dimension;coeff[idx]=1
            for p in sorted(self.rows):
                if r[p]:
                    q=r[p];b,bc=self.rows[p];r=[x-q*y for x,y in zip(r,b)];coeff=[x-q*y for x,y in zip(coeff,bc)]
            p=next(i for i,x in enumerate(r) if x);q=r[p]
            r=[x/q for x in r];coeff=[x/q for x in coeff];self.rows[p]=(r,coeff)
    def coordinates(self,row):
        r=list(row);coeff=[Fraction(0)]*self.dimension
        for p in sorted(self.rows):
            if r[p]:
                q=r[p];b,bc=self.rows[p];r=[x-q*y for x,y in zip(r,b)];coeff=[x+q*y for x,y in zip(coeff,bc)]
        assert not any(r);return coeff

def exact_rank(rows):
    b=RationalBasis(rows);return b.rank

side=RationalBasis(SIDE)
M_res=[side.reduce(r) for r in FOUR];T_res=[side.reduce(r) for r in GROUND]
assert RationalBasis(T_res).rank==15
BLOCK_LABELS=list(combinations(range(1,8),3));BLOCKS=[]
for face in BLOCK_LABELS:
    ids=tuple(i for i,d in enumerate(DESC) if set(d)=={0,*face});assert len(ids)==3;BLOCKS.append(ids)
SECTION_IDS=[e for block in BLOCKS for e in block[:2]]
coord_basis=RationalCoordinateBasis([M_res[e] for e in SECTION_IDS]+T_res)
COORD=[coord_basis.coordinates(r) for r in M_res]
assert all(x.denominator==1 for c in COORD for x in c)
QCOORD=[tuple(int(x) for x in c[:70]) for c in COORD];MCOORD=[tuple(int(x) for x in c) for c in COORD]
assert exact_rank(MCOORD)==85 and exact_rank(QCOORD)==70
LOCAL=((1,0),(0,1),(1,-1))
for b,ids in enumerate(BLOCKS):
    for j,e in enumerate(ids):
        support=[(QCOORD[e][2*h],QCOORD[e][2*h+1]) for h in range(35)]
        assert support[b]==LOCAL[j] and all(v==(0,0) for h,v in enumerate(support) if h!=b)
NO_ROOT=[i for i,d in enumerate(DESC) if 0 not in d];assert len(NO_ROOT)==105
BLOCK_INDEX={face:i for i,face in enumerate(BLOCK_LABELS)}
QCOMP={}
for e in NO_ROOT:
    comp=tuple((QCOORD[e][2*b],QCOORD[e][2*b+1]) for b in range(35))
    touched={b for b,v in enumerate(comp) if v!=(0,0)}
    exp={BLOCK_INDEX[tuple(face)] for face in combinations(sorted(set(DESC[e])),3)}
    assert touched==exp and len(touched)==4;QCOMP[e]=comp
STATES=[]
for mask in range(8):
    chosen=[j for j in range(3) if (mask>>j)&1];cost=len(chosen);complete=mask==7
    if cost==0:kind,line,p=0,None,0
    elif cost==1:kind,line,p=1,LOCAL[chosen[0]],1
    else:kind,line,p=2,None,0 if complete else 2
    STATES.append((mask,cost,complete,kind,line,p))

def norm_frac_row(row):
    r=[Fraction(x) for x in row]
    p=next((i for i,x in enumerate(r) if x),None)
    if p is None:return None
    q=r[p];return tuple(x/q for x in r)

def rowspace_key(rows):
    basis={}
    for row in rows:
        r=[Fraction(x) for x in row]
        for p in sorted(basis):
            if r[p]:
                q=r[p];br=basis[p];r=[x-q*y for x,y in zip(r,br)]
        p=next((i for i,x in enumerate(r) if x),None)
        if p is None:continue
        q=r[p];r=[x/q for x in r]
        # eliminate this pivot from existing rows to canonical RREF
        for p0 in list(basis):
            if basis[p0][p]:
                q0=basis[p0][p];basis[p0]=[x-q0*y for x,y in zip(basis[p0],r)]
        basis[p]=r
    return tuple(tuple(basis[p]) for p in sorted(basis))
@functools.lru_cache(maxsize=None)
def union_key(a,b):return rowspace_key(a+b)

def local_constraint_key(ext,b,s):
    vals=[QCOMP[e][b] for e in ext]
    kind=STATES[s][3]
    if kind==2:return ()
    if kind==1:
        lx,ly=STATES[s][4]
        n=[lx*v[1]-ly*v[0] for v in vals]
        return rowspace_key((tuple(n),))
    x=tuple(v[0] for v in vals);y=tuple(v[1] for v in vals)
    return rowspace_key((x,y))

def primitive_int(v):
    ds=[x.denominator for x in v];L=1
    for d in ds:L=lcm(L,d)
    a=[int(x*L) for x in v];g=0
    for x in a:g=gcd(g,abs(x))
    if g:a=[x//g for x in a]
    for x in a:
        if x:
            if x<0:a=[-y for y in a]
            break
    return tuple(a)

def nullspace_int(key,n=4):
    # key is RREF rows, pivot columns inferred
    piv=[]
    for row in key:
        p=next(i for i,x in enumerate(row) if x);piv.append(p)
    free=[j for j in range(n) if j not in piv]
    out=[]
    for f in free:
        v=[Fraction(0)]*n;v[f]=1
        for row,p in zip(key,piv):v[p]=-row[f]
        out.append(primitive_int(v))
    return out

def solve_local_coeffs_int(mask,w):
    wx,wy=w;chosen=[j for j in range(3) if (mask>>j)&1]
    if not chosen:
        assert wx==0 and wy==0;return [0,0,0]
    if len(chosen)==1:
        j=chosen[0];ux,uy=LOCAL[j]
        q=wx//ux if ux else wy//uy
        assert q*ux==wx and q*uy==wy
        out=[0,0,0];out[j]=q;return out
    j,h=chosen[:2];ax,ay=LOCAL[j];bx,by=LOCAL[h];det=ax*by-ay*bx
    q=(wx*by-wy*bx)//det;r=(ax*wy-ay*wx)//det
    assert q*ax+r*bx==wx and q*ay+r*by==wy
    out=[0,0,0];out[j]=q;out[h]=r;return out

def relation_rows_int(ext,touched,states,constraint_key):
    rows=[]
    for b,s in zip(touched,states):
        if STATES[s][2]:
            ids=BLOCKS[b];rows.append([MCOORD[ids[0]][70+j]-MCOORD[ids[1]][70+j]-MCOORD[ids[2]][70+j] for j in range(15)])
    for alpha in nullspace_int(constraint_key,4):
        tv=[sum(alpha[i]*MCOORD[e][70+j] for i,e in enumerate(ext)) for j in range(15)]
        for b,s in zip(touched,states):
            vx=sum(alpha[i]*QCOMP[e][b][0] for i,e in enumerate(ext));vy=sum(alpha[i]*QCOMP[e][b][1] for i,e in enumerate(ext))
            beta=solve_local_coeffs_int(STATES[s][0],(-vx,-vy));ids=BLOCKS[b]
            for j0,q in enumerate(beta):
                if q:
                    for jj in range(15):tv[jj]+=q*MCOORD[ids[j0]][70+jj]
        rows.append(tv)
    return rows
P=(1<<127)-1
def rank_mod(rows,p=P):
    a=[[x%p for x in row] for row in rows];r=0;n=len(a)
    for c in range(15):
        piv=next((i for i in range(r,n) if a[i][c]),None)
        if piv is None:continue
        a[r],a[piv]=a[piv],a[r];pv=a[r][c]
        for i in range(r+1,n):
            q=a[i][c]
            if q:a[i]=[(pv*x-q*y)%p for x,y in zip(a[i],a[r])]
        r+=1
        if r==n:break
    return r
MAX_NORM2=0
def relation_defect(ext,touched,states,constraint_key):
    global MAX_NORM2
    rows=relation_rows_int(ext,touched,states,constraint_key)
    for row in rows:MAX_NORM2=max(MAX_NORM2,sum(x*x for x in row))
    delta=rank_mod(rows)
    n=4+sum(STATES[s][1] for s in states)
    return n-3*delta,delta,len(rows)


def cycle_key(desc):
    d = list(desc)
    return tuple(sorted(tuple(sorted((d[i], d[(i + 1) % 4]))) for i in range(4)))


def four_no_root_orbits():
    """Return exact S7 orbit representatives of 4-subsets of the 105 no-root cycles."""
    keys = sorted(cycle_key(DESC[e]) for e in NO_ROOT)
    key_to_local = {key: i for i, key in enumerate(keys)}
    key_to_global = {cycle_key(DESC[e]): e for e in NO_ROOT}

    perm_maps = []
    for perm in permutations(range(1, 8)):
        pmap = {i + 1: perm[i] for i in range(7)}
        arr = []
        for key in keys:
            mapped = tuple(sorted(tuple(sorted((pmap[a], pmap[b]))) for a, b in key))
            arr.append(key_to_local[mapped])
        perm_maps.append(tuple(arr))
    assert len(perm_maps) == 5040

    def rank4(t):
        a, b, c, d = t
        return a + comb(b, 2) + comb(c, 3) + comb(d, 4)

    total = comb(105, 4)
    seen4 = bytearray(total)
    out = []
    for t in combinations(range(105), 4):
        r = rank4(t)
        if seen4[r]:
            continue
        orbit = {
            tuple(sorted((arr[t[0]], arr[t[1]], arr[t[2]], arr[t[3]])))
            for arr in perm_maps
        }
        for u in orbit:
            seen4[rank4(u)] = 1
        ext = tuple(key_to_global[keys[i]] for i in t)
        touched = tuple(sorted(
            b for b in range(35)
            if any(QCOMP[e][b] != (0, 0) for e in ext)
        ))
        out.append((ext, len(orbit), touched))
    assert len(out) == 1186
    assert sum(size for _ext, size, _touched in out) == total == 4_780_230
    return out


def is_subspace(a, b):
    """Whether rowspace a is contained in rowspace b (both RREF keys)."""
    return len(union_key(a, b)) == len(b)


def candidate_rank2_constraint_planes(ext, touched):
    """All possible global rank-2 constraint spaces for k=2,p<=1 states."""
    sources = []
    # p<=1 means every incomplete touched block is empty, except possibly one
    # singleton. Complete blocks contribute no external constraint.
    for b in touched:
        for state in (0, 1, 2, 4):
            key = local_constraint_key(ext, b, state)
            if len(key) <= 2:
                sources.append((b, state, key))

    planes = set()
    for _b, _state, key in sources:
        if len(key) == 2:
            planes.add(key)
    for i, (b1, s1, k1) in enumerate(sources):
        if len(k1) != 1:
            continue
        for b2, s2, k2 in sources[i + 1:]:
            if b1 == b2 or len(k2) != 1:
                continue
            # An actual p<=1 state cannot contain two singleton blocks.
            if s1 != 0 and s2 != 0:
                continue
            key = union_key(k1, k2)
            if len(key) == 2:
                planes.add(key)
    return planes


def canonical_minimal_completion(ext, touched, plane, singleton=None):
    """Canonical least-row state realizing a fixed rank-2 constraint plane.

    For a fixed plane and (optionally) fixed singleton block, every other
    touched block is left empty whenever its empty-state constraint is already
    contained in the plane; otherwise it must be completed. This is the unique
    inclusion-minimal completion relevant to the monotonicity proof.
    """
    states = []
    for b in touched:
        if singleton is not None and b == singleton[0]:
            state = singleton[1]
            if not is_subspace(local_constraint_key(ext, b, state), plane):
                return None
            states.append(state)
            continue
        empty_key = local_constraint_key(ext, b, 0)
        states.append(0 if is_subspace(empty_key, plane) else 7)

    key = ()
    for b, state in zip(touched, states):
        key = union_key(key, local_constraint_key(ext, b, state))
    if key != plane:
        return None
    return tuple(states)


def scan_rank2_branch(orbits, start, stop):
    global MAX_NORM2
    counts = Counter()
    minima = {0: None, 1: None}
    negatives = []
    plane_count = Counter()
    orbit_size_count = Counter()
    touched_count = Counter()
    MAX_NORM2 = 0

    for orbit_index in range(start, stop):
        ext, orbit_size, touched = orbits[orbit_index]
        orbit_size_count[orbit_size] += 1
        touched_count[len(touched)] += 1
        planes = candidate_rank2_constraint_planes(ext, touched)
        plane_count[len(planes)] += 1
        seen_states = set()

        for plane in planes:
            states = canonical_minimal_completion(ext, touched, plane)
            if states is not None:
                signature = (plane, None, states)
                if signature not in seen_states:
                    seen_states.add(signature)
                    defect, delta, nrel = relation_defect(ext, touched, states, plane)
                    counts[0] += 1
                    minima[0] = defect if minima[0] is None else min(minima[0], defect)
                    if defect < 0:
                        negatives.append((orbit_index, 0, defect, ext, touched, plane, states, delta, nrel))

            for b in touched:
                for state in (1, 2, 4):
                    if not is_subspace(local_constraint_key(ext, b, state), plane):
                        continue
                    states = canonical_minimal_completion(ext, touched, plane, (b, state))
                    if states is None:
                        continue
                    signature = (plane, (b, state), states)
                    if signature in seen_states:
                        continue
                    seen_states.add(signature)
                    defect, delta, nrel = relation_defect(ext, touched, states, plane)
                    counts[1] += 1
                    minima[1] = defect if minima[1] is None else min(minima[1], defect)
                    if defect < 0:
                        negatives.append((orbit_index, 1, defect, ext, touched, plane, states, delta, nrel))

        if negatives:
            break

    return {
        "start": start,
        "stop": stop,
        "orbits_checked": stop - start,
        "canonical_p0_states": counts[0],
        "canonical_p1_states": counts[1],
        "canonical_states": counts[0] + counts[1],
        "min_defect_p0": minima[0],
        "min_defect_p1": minima[1],
        "negative_states": len(negatives),
        "max_relation_row_norm_squared": MAX_NORM2,
        "plane_count_distribution": dict(sorted(plane_count.items())),
        "orbit_size_distribution": dict(sorted(orbit_size_count.items())),
        "touched_block_distribution": dict(sorted(touched_count.items())),
        "first_negative": negatives[0] if negatives else None,
    }


def lucas_lehmer_127():
    assert all(127 % d for d in range(2, 12))
    s = 4
    for _ in range(125):
        s = (s * s - 2) % P
    return s == 0


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--orbit-start", type=int, default=0)
    parser.add_argument("--orbit-end", type=int)
    args = parser.parse_args()

    assert lucas_lehmer_127()
    orbits = four_no_root_orbits()
    end = len(orbits) if args.orbit_end is None else args.orbit_end
    assert 0 <= args.orbit_start <= end <= len(orbits)
    result = scan_rank2_branch(orbits, args.orbit_start, end)
    assert result["negative_states"] == 0, result["first_negative"]
    B = max(1, result["max_relation_row_norm_squared"])
    assert P * P > B ** 15

    print("PASS: four-no-root k=2,p<=1 rank-density branch")
    print("four_no_root_subsets", comb(105, 4))
    print("S7_orbits", len(orbits))
    print("orbit_range", args.orbit_start, end)
    print("orbits_checked", result["orbits_checked"])
    print("canonical_p0_states", result["canonical_p0_states"])
    print("canonical_p1_states", result["canonical_p1_states"])
    print("canonical_states", result["canonical_states"])
    print("min_defect_p0", result["min_defect_p0"])
    print("min_defect_p1", result["min_defect_p1"])
    print("negative_states", result["negative_states"])
    print("max_relation_row_norm_squared", result["max_relation_row_norm_squared"])
    print("hadamard_exact_rank_bound", P * P > B ** 15)
    print("orbit_size_distribution", result["orbit_size_distribution"])
    print("touched_block_distribution", result["touched_block_distribution"])
    print("plane_count_distribution", result["plane_count_distribution"])


if __name__ == "__main__":
    main()
