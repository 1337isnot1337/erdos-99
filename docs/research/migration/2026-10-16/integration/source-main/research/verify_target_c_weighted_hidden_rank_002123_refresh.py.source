#!/usr/bin/env python3
"""Regression checks for the 0.002123 hidden-rank refresh and degree-5 alphabet."""
from decimal import Decimal, getcontext
from itertools import product
import math

getcontext().prec = 70
D = Decimal
pi = D('3.141592653589793238462643383279502884197169399375105820974944592307816')
sqrt3 = D(3).sqrt()
s = (pi / (D(2) * sqrt3)).sqrt()
g = D('0.002123')
eps = D('0.0017327')

t0 = D(4) / D(9) * (pi + s) + eps
Cg = D(2) * s + g
q0 = D(2) * t0 - pi
R0 = D(7) * pi + D(3) * Cg - D(27) * t0 / D(2)
F0 = (R0 - D(2) * q0) / D(2)
theta = D(4) * F0 / D(7)
n5 = theta / D(2)
n2 = q0 - n5
rho = D(3) * n5
y = D(2) * n2 + D(5) * n5
kout = D(10) * F0 / D(7)
gap = D(3) * F0 / D(7)
u0 = D(6) * F0 / D(7)
outer_gap = pi - R0

assert abs(R0 - (D(2) * theta + y)) < D('1e-60')
assert abs(rho - u0) < D('1e-60')
assert abs(kout - (theta + rho)) < D('1e-60')
assert abs(outer_gap - (D(27) * eps / D(2) - D(3) * g)) < D('1e-60')

assert abs(q0 - D('0.5008998223690961698008711140858835913763598934133')) < D('1e-49')
assert abs(R0 - D('3.1245702035897932384626433832795028841971693993751')) < D('1e-49')
assert abs(F0 - D('1.0613852794258004494304505775538678507222248062742')) < D('1e-49')
assert abs(theta - D('0.6065058739576002568174003300307816289841284607281')) < D('1e-49')
assert abs(n5 - D('0.3032529369788001284087001650153908144920642303641')) < D('1e-49')
assert abs(n2 - D('0.1976468853902960413921709490704927768842956630492')) < D('1e-49')
assert abs(y - D('1.9115584556745927248278427232179396262289124779188')) < D('1e-49')
assert outer_gap == D('0.01702245')

# Flat-pentagon subset-sum projective alphabet.
a = math.sqrt(3.0) / 2.0
E = [(1.0, 0.0), (1.0, 0.0), (-0.5, a), (-1.0, 0.0), (-0.5, -a)]
angles = set()
for bits in product((0, 1), repeat=5):
    x = sum(bits[i] * E[i][0] for i in range(5))
    y0 = sum(bits[i] * E[i][1] for i in range(5))
    if abs(x) < 1e-12 and abs(y0) < 1e-12:
        continue
    ang = math.degrees(math.atan2(y0, x) % math.pi)
    angles.add(round(ang, 9))
assert angles == {0.0, 30.0, 60.0, 120.0, 150.0}

print('PASS')
print('t0 =', t0)
print('q0 =', q0)
print('R0 =', R0)
print('F0 =', F0)
print('Theta =', theta)
print('n5 =', n5)
print('n2 =', n2)
print('L_OF/D =', y)
print('outer unused occurrence density =', outer_gap)
print('flat subset-sum projective degrees =', sorted(angles))
