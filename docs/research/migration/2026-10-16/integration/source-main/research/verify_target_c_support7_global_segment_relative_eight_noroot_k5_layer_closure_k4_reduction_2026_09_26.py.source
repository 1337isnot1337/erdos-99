#!/usr/bin/env python3
"""Arithmetic/combinatorial checker for the eight-no-root k=5 closure/k=4 reduction."""
from itertools import combinations
from math import ceil

def branches(k, D):
    rhs = D - 8 + 3 * k
    out = []
    for d_root in range(10):
        p = rhs - 3 * d_root
        if p >= 0:
            out.append((d_root, p))
    return tuple(out)

def weight_floors(D, rank):
    return tuple(ceil((3 * j - D) / 2) for j in range(1, rank + 1))

assert branches(5, -2) == ((0, 5), (1, 2))
assert branches(5, -1) == ((0, 6), (1, 3), (2, 0))
assert branches(4, -2) == ((0, 2),)
assert branches(4, -1) == ((0, 3), (1, 0))
assert weight_floors(-2, 4) == (3, 4, 6, 7)
assert weight_floors(-1, 4) == (2, 4, 5, 7)

for D in (-2, -1):
    s = 1
    q = 0
    assert (D + 2 * s - 3 * q, (8 - s) - (4 - q)) == (D + 2, 3)

D, s, q = -2, 2, 0
assert (D + 2 * s - 3 * q, (8 - s) - (4 - q)) == (2, 2)

D, s = -1, 2
assert (D + 2 * s - 3, (8 - s) - (4 - 1)) == (0, 3)
assert (D + 2 * s, (8 - s) - 4) == (3, 2)

pairs = tuple(combinations(range(8), 2))
max_size = 0
size4 = []
for r in range(1, 5):
    for fam in combinations(pairs, r):
        if all(set(a).isdisjoint(b) for a, b in combinations(fam, 2)):
            max_size = max(max_size, r)
            if r == 4:
                size4.append(fam)

assert max_size == 4
assert len(size4) == 105
assert all(len(set().union(*map(set, fam))) == 8 for fam in size4)

print("PASS: k=5 arithmetic boundary and k=4 rank-four reduction")
print("k5_branches", branches(5, -2) + branches(5, -1))
print("k4_Dminus2", branches(4, -2), "weights", weight_floors(-2, 4))
print("k4_Dminus1", branches(4, -1), "weights", weight_floors(-1, 4))
print("perfect_matchings", len(size4))
