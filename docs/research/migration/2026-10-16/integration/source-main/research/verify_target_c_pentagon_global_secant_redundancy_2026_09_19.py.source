#!/usr/bin/env python3
"""Exact coefficient check for the global two-gap secant redundancy."""
from fractions import Fraction as Q


def add(a, b):
    return tuple(x + y for x, y in zip(a, b))


def mul(c, a):
    return tuple(c * x for x in a)


def qrow(i):
    # q_i - 1/3 = x_i + x_{i+1} - x_{i+3} - 1/3.
    row = [Q(0)] * 6
    row[i] += 1
    row[(i + 1) % 5] += 1
    row[(i + 3) % 5] -= 1
    row[5] -= Q(1, 3)
    return tuple(row)


def chord_slack(k):
    # 2/3 + x_k/2 - x_{k+2} - x_{k+3}.
    row = [Q(0)] * 6
    row[k] += Q(1, 2)
    row[(k + 2) % 5] -= 1
    row[(k + 3) % 5] -= 1
    row[5] += Q(2, 3)
    return tuple(row)


# Equality row sum_i x_i - 2 = 0.
SUM_ROW = tuple([Q(1)] * 5 + [Q(-2)])

for k in range(5):
    lhs = chord_slack(k)
    rhs = mul(Q(1, 2), add(qrow(k), qrow((k - 1) % 5)))
    difference = tuple(a - b for a, b in zip(lhs, rhs))
    assert difference == mul(Q(-1, 2), SUM_ROW)

print(
    "PASS: all five global chord cuts are exactly averages of adjacent "
    "q facets modulo sum x=2."
)
