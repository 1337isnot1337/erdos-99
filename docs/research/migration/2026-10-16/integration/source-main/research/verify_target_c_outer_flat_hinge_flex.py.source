#!/usr/bin/env python3
from decimal import Decimal, getcontext

getcontext().prec = 70
D = Decimal
PI = D('3.141592653589793238462643383279502884197169399375105820974944')
SQ = D('0.9523128068639573458338104262565569008230510550118582389446084732508783')
C0 = 2 * SQ + D('0.00042')

def m(t):
    return (7 * PI + 3 * C0 - D('13.5') * t) / 3

def qmax(t):
    return 2 * t - PI

def n2(t):
    return (m(t) - qmax(t)) / 4

def n3(t):
    return (m(t) - 2 * qmax(t)) / 3

t42 = D(4) / D(9) * (PI + SQ) + D('0.0013751')

assert n2(t42) > D('0.13531')
assert n3(t42) > D('0.01368')
assert n2(D('1.8585')) > D('0.07419')

# The localized three-train kernels need not be o(T).  It suffices that their
# maximal support 3*N3 <= 3*Q leaves a strict linear gap below the train floor.
def support_gap(t):
    return C0 + 3 * PI - D('5.5') * t

assert support_gap(t42) > D('1.31')
assert support_gap(D('1.8585')) > D('1.108')

print('PASS outer-flat hinge/flex arithmetic')
print('t42=', t42)
print('m_t42=', m(t42))
print('Qmax_t42=', qmax(t42))
print('N2_floor_t42=', n2(t42))
print('single_hinge_type_floor_t42=', n2(t42) / 2)
print('N3_floor_t42=', n3(t42))
print('N2_floor_1.8585=', n2(D('1.8585')))
print('unused_train_support_gap_t42>=', support_gap(t42))
print('unused_train_support_gap_1.8585>=', support_gap(D('1.8585')))
print('single_hinge_type_floor_1.8585=', n2(D('1.8585')) / 2)
