#!/usr/bin/env python3
"""Regression checks for phase-free laminar diameter half-saturation.

The proof is the exact row-space factorization in
`target_c_free_terminal_laminar_diameter_half_saturation_2026-09-18.md`.
This script checks the factorization on randomized tree split data, the integer
consequences, an abstract sharpness family, and the terminal constants. It does
not replace the cited mixed-rigidity or diameter-path Helly theorems.
"""

from __future__ import annotations

import math
import random

G = 0.007707
C_LAM = math.pi / 10.0 - G / 5.0
C_SECTOR6 = math.pi / 60.0 - G / 5.0


def rank(a: list[list[float]], tol: float = 1e-10) -> int:
    if not a:
        return 0
    mat = [row[:] for row in a]
    rows = len(mat)
    cols = len(mat[0])
    r = 0
    for c in range(cols):
        if r >= rows:
            break
        pivot = max(range(r, rows), key=lambda i: abs(mat[i][c]))
        if abs(mat[pivot][c]) <= tol:
            continue
        mat[r], mat[pivot] = mat[pivot], mat[r]
        p = mat[r][c]
        for j in range(c, cols):
            mat[r][j] /= p
        for i in range(rows):
            if i == r:
                continue
            q = mat[i][c]
            if abs(q) <= tol:
                continue
            for j in range(c, cols):
                mat[i][j] -= q * mat[r][j]
        r += 1
    return r


def random_tree(
    rng: random.Random, vertices: int
) -> tuple[list[int], list[list[int]]]:
    parent = [-1]
    children: list[list[int]] = [[] for _ in range(vertices)]
    for v in range(1, vertices):
        p = rng.randrange(v)
        parent.append(p)
        children[p].append(v)
    return parent, children


def descendants(children: list[list[int]], root: int) -> set[int]:
    out: set[int] = set()
    stack = [root]
    while stack:
        v = stack.pop()
        out.add(v)
        stack.extend(children[v])
    return out


def shore_matrix(
    parent: list[int], children: list[list[int]]
) -> list[list[int]]:
    n = len(parent)
    desc = [descendants(children, child) for child in range(1, n)]
    return [[1 if v in d else 0 for d in desc] for v in range(n)]


def factor_vectors(
    chi: list[list[int]],
    dirs: list[tuple[float, float]],
    loaded: list[int],
) -> tuple[dict[int, list[float]], dict[int, list[float]]]:
    ref = loaded[0]
    x: dict[int, list[float]] = {}
    y: dict[int, list[float]] = {}
    for v in loaded:
        x[v] = [
            (chi[v][i] - chi[ref][i]) * dirs[i][0]
            for i in range(len(dirs))
        ]
        y[v] = [
            (chi[v][i] - chi[ref][i]) * dirs[i][1]
            for i in range(len(dirs))
        ]
    return x, y


def derivative_row(
    chi: list[list[int]],
    dirs: list[tuple[float, float]],
    v: int,
    w: int,
    rvec: tuple[float, float],
) -> list[float]:
    rx, ry = rvec
    return [
        (chi[v][i] - chi[w][i])
        * (rx * dirs[i][0] + ry * dirs[i][1])
        for i in range(len(dirs))
    ]


def randomized_factorization(trials: int = 50_000) -> None:
    rng = random.Random(0xE99A1F)
    for _ in range(trials):
        m = rng.randint(1, 18)
        parent, children = random_tree(rng, m + 1)
        chi = shore_matrix(parent, children)

        dirs: list[tuple[float, float]] = []
        for _i in range(m):
            angle = rng.random() * 2.0 * math.pi
            dirs.append((math.cos(angle), math.sin(angle)))

        b = rng.randint(2, m + 1)
        loaded = rng.sample(range(m + 1), b)
        x, y = factor_vectors(chi, dirs, loaded)
        ref = loaded[0]
        generators = [x[v] for v in loaded if v != ref]
        generators += [y[v] for v in loaded if v != ref]

        rows: list[list[float]] = []
        for _j in range(rng.randint(1, 4 * b + 4)):
            v, w = rng.sample(loaded, 2)
            angle = rng.random() * 2.0 * math.pi
            rvec = (math.cos(angle), math.sin(angle))
            row = derivative_row(chi, dirs, v, w, rvec)
            rows.append(row)

            rx, ry = rvec
            factored = [
                rx * (x[v][i] - x[w][i])
                + ry * (y[v][i] - y[w][i])
                for i in range(m)
            ]
            assert max(abs(a - z) for a, z in zip(row, factored)) < 2e-12

        assert rank(rows) <= rank(generators)
        assert rank(generators) <= 2 * (b - 1)


def integer_consequences() -> None:
    for m in range(1, 1000):
        bmin = 1 + math.ceil(m / 2)
        assert m <= 2 * (bmin - 1)
        assert bmin == min(
            b for b in range(1, m + 2) if m <= 2 * (b - 1)
        )

        nonhub = bmin - 1
        crossing_edges = math.ceil(nonhub / 2)
        assert crossing_edges >= math.ceil(math.ceil(m / 2) / 2)


def abstract_sharpness() -> None:
    """Path split data attain rank m with b=1+ceil(m/2).

    This is algebraic only; it is not a geometric extremal-source construction.
    """
    for m in range(1, 101):
        chi = [[1 if v > i else 0 for i in range(m)] for v in range(m + 1)]
        dirs = [
            (1.0, 0.0) if i % 2 == 0 else (0.0, 1.0)
            for i in range(m)
        ]

        loaded = [0] + list(range(2, m + 1, 2))
        if loaded[-1] != m:
            loaded.append(m)
        assert len(loaded) == 1 + math.ceil(m / 2)

        rows: list[list[float]] = []
        for a, b in zip(loaded, loaded[1:]):
            for rvec in ((1.0, 0.0), (0.0, 1.0)):
                row = derivative_row(chi, dirs, b, a, rvec)
                if any(abs(z) > 0.5 for z in row):
                    rows.append(row)
        assert rank(rows) == m


def terminal_constants() -> None:
    assert abs(C_LAM - 0.3126178653589793) < 3e-15
    assert abs(C_LAM / 2.0 - 0.15630893267948965) < 3e-15
    assert abs(C_LAM / 4.0 - 0.07815446633974482) < 3e-15

    assert abs(C_SECTOR6 - 0.05081847755982988) < 3e-15
    assert abs(C_SECTOR6 / 2.0 - 0.02540923877991494) < 3e-15
    assert abs(C_SECTOR6 / 4.0 - 0.01270461938995747) < 3e-15


def main() -> None:
    randomized_factorization()
    integer_consequences()
    abstract_sharpness()
    terminal_constants()

    print("terminal FREE laminar diameter half-saturation: PASS")
    print(f"global laminar density={C_LAM:.15f}")
    print(f"loaded-region density={C_LAM/2.0:.15f}")
    print(f"crossing-diameter density={C_LAM/4.0:.15f}")
    print(f"pi/6 laminar density={C_SECTOR6:.15f}")
    print(f"pi/6 loaded-region density={C_SECTOR6/2.0:.15f}")
    print(f"pi/6 crossing-diameter density={C_SECTOR6/4.0:.15f}")


if __name__ == "__main__":
    main()
