from __future__ import annotations

import importlib.util
import json
import re
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SPEC = importlib.util.spec_from_file_location(
    "publication_inventory", ROOT / "tools/publication_inventory.py"
)
assert SPEC and SPEC.loader
inventory_module = importlib.util.module_from_spec(SPEC)
sys.modules[SPEC.name] = inventory_module
SPEC.loader.exec_module(inventory_module)


class PublicationInventoryTests(unittest.TestCase):
    def test_project_tool_is_only_a_candidate_include(self):
        action, reason = inventory_module.classify_path("tools/check_theorem_state.py")
        self.assertEqual(action, "include")
        self.assertIn("license", reason)

    def test_papers_and_derived_extracts_are_excluded(self):
        self.assertEqual(
            inventory_module.classify_path("papers/primary/source.pdf")[0], "exclude"
        )
        self.assertEqual(
            inventory_module.classify_path("extracted/text/source.txt")[0], "exclude"
        )

    def test_historical_reports_and_generated_archive_index_are_excluded(self):
        self.assertEqual(
            inventory_module.classify_path("docs/reports/old-attempt.md")[0], "exclude"
        )
        self.assertEqual(
            inventory_module.classify_path("docs/state/artifact-index.jsonl")[0], "exclude"
        )

    def test_active_mathematical_content_requires_human_review(self):
        self.assertEqual(
            inventory_module.classify_path("docs/targets/target-c/CURRENT.md")[0], "review"
        )
        self.assertEqual(inventory_module.classify_path("AGENTS.md")[0], "review")

    def test_unknown_paths_fail_closed_to_review(self):
        self.assertEqual(inventory_module.classify_path("new-content/notes.txt")[0], "review")

    def test_ref_rejects_option_like_input(self):
        with self.assertRaises(ValueError):
            inventory_module.resolve_commit(str(ROOT), "--all")

    def test_cli_emits_a_complete_committed_tree_inventory(self):
        result = subprocess.run(
            [sys.executable, str(ROOT / "tools/publication_inventory.py"), "--ref", "HEAD"],
            cwd=ROOT,
            check=True,
            capture_output=True,
            text=True,
        )
        inventory = json.loads(result.stdout)
        self.assertEqual(inventory["commit"], subprocess.check_output(
            ["git", "rev-parse", "HEAD"], cwd=ROOT, text=True
        ).strip())
        manifest = subprocess.check_output(
            ["git", "show", "HEAD:docs/state/theorem-state.yaml"],
            cwd=ROOT,
            text=True,
        )
        expected_state = re.search(r'^state_version:\s*["\']?([^"\'\s]+)', manifest, re.M)
        self.assertIsNotNone(expected_state)
        self.assertEqual(inventory["state_version"], expected_state.group(1))
        paths = {entry["path"] for entry in inventory["entries"]}
        expected_paths = {p for p in subprocess.check_output(
            ["git", "ls-tree", "-rz", "--name-only", "HEAD"], cwd=ROOT
        ).decode().split("\0") if p}
        self.assertEqual(paths, expected_paths)
        self.assertEqual(sum(inventory["action_counts"].values()), len(paths))
        self.assertEqual(inventory["root_license_present"], any(
            "/" not in p and p.lower() in inventory_module.ROOT_LICENSE_NAMES for p in paths))
        self.assertIn("docs/STATE.md", paths)

    def test_cli_accepts_a_clean_history_tree_without_private_literature(self):
        with tempfile.TemporaryDirectory() as tmp:
            root = Path(tmp)
            def git(*args):
                subprocess.run(["git", "-C", tmp, *args], check=True, capture_output=True)
            git("init", "-q")
            git("config", "user.name", "Inventory Fixture")
            git("config", "user.email", "fixture@example.invalid")
            (root / "docs/state").mkdir(parents=True)
            (root / "docs/state/theorem-state.yaml").write_text('state_version: "fixture"\n')
            (root / "README.md").write_text("# Curated fixture\n")
            for licensed in (False, True):
                if licensed:
                    # Presence detection only: this grants no rights to real files.
                    (root / "COPYING.txt").write_text("Test fixture license placeholder\n")
                git("add", ".")
                git("commit", "-qm", "fixture")
                result = subprocess.run([sys.executable, str(ROOT / "tools/publication_inventory.py"),
                    "--root", tmp, "--summary"], check=True, capture_output=True, text=True)
                self.assertEqual(json.loads(result.stdout)["root_license_present"], licensed)


if __name__ == "__main__":
    unittest.main()
