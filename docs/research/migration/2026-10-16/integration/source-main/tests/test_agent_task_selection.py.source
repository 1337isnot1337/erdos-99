import copy
import json
from pathlib import Path
import subprocess
import sys
import unittest


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))

import choose_research_task as selector  # noqa: E402


class AgentTaskSelectionTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.catalog = json.loads(
            (ROOT / "docs/research/agent-task-catalog.json").read_text(encoding="utf-8")
        )

    def test_catalogue_has_sixteen_to_twenty_four_complete_cards(self):
        selector.validate_catalog(self.catalog, ROOT)
        self.assertGreaterEqual(len(self.catalog["tasks"]), 16)
        self.assertLessEqual(len(self.catalog["tasks"]), 24)
        self.assertEqual(sum(track["weight"] for track in self.catalog["tracks"]), 100)

    def test_referenced_files_exist_and_overlap_prs_are_pinned(self):
        selector.validate_catalog(self.catalog, ROOT)
        snapshot = {pr["number"] for pr in self.catalog["open_pr_snapshot"]}
        for task in self.catalog["tasks"]:
            self.assertTrue(task["canonical_dependencies"])
            self.assertTrue(task["previous_obstructions"])
            self.assertTrue(set(task["potential_open_overlap_prs"]).issubset(snapshot))

    def test_same_seed_reproduces_tasks_methods_and_scope_keys(self):
        seed = "0123456789abcdef0123456789abcdef"
        first = selector.select_tasks(self.catalog, seed, count=3)
        second = selector.select_tasks(self.catalog, seed, count=3)
        self.assertEqual(first, second)
        self.assertTrue(all(len(task["scope_key"]) == 20 for task in first))

    def test_default_shortlist_uses_distinct_tracks(self):
        suggestions = selector.select_tasks(
            self.catalog, "0123456789abcdef0123456789abcdef", count=3
        )
        self.assertEqual(len(suggestions), 3)
        self.assertEqual(len({task["track"] for task in suggestions}), 3)
        self.assertEqual(len({task["id"] for task in suggestions}), 3)

    def test_forced_track_stays_within_track_and_samples_without_replacement(self):
        suggestions = selector.select_tasks(
            self.catalog,
            "0123456789abcdef0123456789abcdef",
            count=2,
            track_id="target-c",
        )
        self.assertEqual(len(suggestions), 2)
        self.assertTrue(all(task["track"] == "target-c" for task in suggestions))
        self.assertEqual(len({task["id"] for task in suggestions}), 2)

    def test_named_task_retrieval_returns_one_card(self):
        task_id = "target-c-face-coupled-move"
        result = selector.select_tasks(
            self.catalog,
            "0123456789abcdef0123456789abcdef",
            count=3,
            task_id=task_id,
        )
        self.assertEqual([task["id"] for task in result], [task_id])

    def test_scope_key_does_not_depend_on_random_seed(self):
        task = "target-b-multigrain-transfer"
        method = "two-grain exact model"
        self.assertEqual(
            selector.scope_key(task, method), selector.scope_key(task, method)
        )

    def test_invalid_seed_track_and_count_fail_closed(self):
        with self.assertRaises(selector.CatalogError):
            selector.select_tasks(self.catalog, "not-a-seed")
        with self.assertRaises(selector.CatalogError):
            selector.select_tasks(
                self.catalog,
                "0123456789abcdef0123456789abcdef",
                track_id="missing-track",
            )
        with self.assertRaises(selector.CatalogError):
            selector.select_tasks(
                self.catalog,
                "0123456789abcdef0123456789abcdef",
                count=100,
            )

    def test_duplicate_ids_and_missing_paths_are_rejected(self):
        duplicate = copy.deepcopy(self.catalog)
        duplicate["tasks"][1]["id"] = duplicate["tasks"][0]["id"]
        with self.assertRaisesRegex(selector.CatalogError, "duplicate task id"):
            selector.validate_catalog(duplicate, ROOT)

        missing = copy.deepcopy(self.catalog)
        missing["tasks"][0]["canonical_dependencies"][0]["path"] = "docs/does-not-exist.md"
        with self.assertRaisesRegex(selector.CatalogError, "missing file"):
            selector.validate_catalog(missing, ROOT)

        bad_authority = copy.deepcopy(self.catalog)
        bad_authority["authority"].append("docs/authority-file-not-present.md")
        with self.assertRaisesRegex(selector.CatalogError, "missing file"):
            selector.validate_catalog(bad_authority, ROOT)

        bad_claim = copy.deepcopy(self.catalog)
        bad_claim["tasks"][0]["canonical_dependencies"][0]["claim_id"] = "NOT-A-REAL-THEOREM-ID"
        with self.assertRaisesRegex(selector.CatalogError, "absent claim ID"):
            selector.validate_catalog(bad_claim, ROOT)

    def test_path_escape_is_rejected(self):
        escaped = copy.deepcopy(self.catalog)
        escaped["tasks"][0]["previous_obstructions"][0]["path"] = "../outside.md"
        with self.assertRaisesRegex(selector.CatalogError, "outside the repository"):
            selector.validate_catalog(escaped, ROOT)

    def test_catalogue_requires_an_exact_base_sha_and_no_reservation_claim(self):
        bad_sha = copy.deepcopy(self.catalog)
        bad_sha["reviewed_base_commit"] = "ab6dd333"
        with self.assertRaisesRegex(selector.CatalogError, "40-character lowercase Git SHA"):
            selector.validate_catalog(bad_sha, ROOT)

        reserved = copy.deepcopy(self.catalog)
        reserved["selection_policy"]["reservation"] = True
        with self.assertRaisesRegex(selector.CatalogError, "reservation=false"):
            selector.validate_catalog(reserved, ROOT)

    def test_cli_prints_machine_readable_nonreservation_status(self):
        completed = subprocess.run(
            [
                sys.executable,
                str(ROOT / "scripts/choose_research_task.py"),
                "--seed",
                "0123456789abcdef0123456789abcdef",
                "--count",
                "2",
                "--json",
            ],
            cwd=ROOT,
            check=True,
            capture_output=True,
            text=True,
        )
        result = json.loads(completed.stdout)
        self.assertEqual(result["status"], "SUGGESTIONS_ONLY_NOT_RESERVED")
        self.assertTrue(result["state_matches_reviewed_snapshot"])
        self.assertEqual(len(result["suggestions"]), 2)


if __name__ == "__main__":
    unittest.main()
